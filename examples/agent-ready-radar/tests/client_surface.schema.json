{
  "$defs": {
    "action": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "pattern": "^[a-z][a-z0-9._-]{1,95}$",
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    "buttonNode": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "glyph": {
          "$ref": "#/$defs/glyph"
        },
        "label": {
          "$ref": "#/$defs/value"
        },
        "type": {
          "const": "button"
        },
        "variant": {
          "enum": [
            "quiet",
            "secondary",
            "primary",
            "danger",
            "footer"
          ]
        }
      },
      "required": [
        "type",
        "label",
        "action"
      ],
      "type": "object"
    },
    "children": {
      "items": {
        "$ref": "#/$defs/node"
      },
      "maxItems": 64,
      "type": "array"
    },
    "collectionBinding": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "dividerNode": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "divider"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "donutNode": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/value"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/donutSegment"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "type": {
          "const": "donut"
        },
        "value": {
          "$ref": "#/$defs/numberValue"
        }
      },
      "required": [
        "type",
        "value",
        "segments"
      ],
      "type": "object"
    },
    "donutSegment": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/value"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "value": {
          "$ref": "#/$defs/numberValue"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "type": "object"
    },
    "glyph": {
      "enum": [
        "octopus",
        "dashboard",
        "registry",
        "metrics",
        "dollar",
        "chat",
        "interfaces",
        "topology",
        "ee",
        "artifact",
        "file",
        "binding",
        "descriptor",
        "filter",
        "search",
        "expand",
        "more",
        "close",
        "copy",
        "trash",
        "send",
        "plus",
        "microphone",
        "voice",
        "volume",
        "volumeOff",
        "phoneEnd",
        "transcript",
        "weather",
        "deviceTablet",
        "deviceMobile",
        "terminal",
        "browser",
        "changes",
        "desktop",
        "retry",
        "stop",
        "paperclip",
        "image",
        "settings",
        "sliders",
        "chevronDown",
        "check",
        "refresh",
        "arrowLeft",
        "navigateBack",
        "sidebarOpen",
        "sidebarClosed",
        "user",
        "sun",
        "keyboard",
        "pulse",
        "newTask",
        "scheduled",
        "plugins",
        "sites",
        "pin",
        "pinOff",
        "project",
        "lightbulb",
        "folder",
        "folderOpen",
        "splitPane",
        "widgets",
        "layers",
        "progress",
        "insights",
        "memory",
        "target",
        "hand"
      ]
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
      "type": "string"
    },
    "imageNode": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "$ref": "#/$defs/value"
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ]
        },
        "ratio": {
          "enum": [
            "square",
            "portrait",
            "landscape",
            "wide"
          ]
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "if": {
                "type": "string"
              },
              "then": {
                "maxLength": 524288,
                "pattern": "^[dD][aA][tT][aA]:[iI][mM][aA][gG][eE]/(?:[aA][vV][iI][fF]|[gG][iI][fF]|[jJ][pP][eE][gG]|[pP][nN][gG]|[wW][eE][bB][pP]);[bB][aA][sS][eE]64,[a-zA-Z0-9+/]+={0,2}$",
                "type": "string"
              }
            }
          ],
          "description": "Native image literals must be embedded AVIF, GIF, JPEG, PNG, or WebP base64 data URLs (at most 524288 characters), not HTTP(S), file, or blob URLs. A value binding must resolve to the same embedded format."
        },
        "type": {
          "const": "image"
        }
      },
      "required": [
        "type",
        "source"
      ],
      "type": "object"
    },
    "inputNode": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "input_kind": {
          "enum": [
            "text",
            "search",
            "url"
          ]
        },
        "label": {
          "$ref": "#/$defs/value"
        },
        "placeholder": {
          "$ref": "#/$defs/value"
        },
        "type": {
          "const": "input"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "keyValueNode": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/value"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "type": {
          "const": "key_value"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "required": [
        "type",
        "label",
        "value"
      ],
      "type": "object"
    },
    "listNode": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "$ref": "#/$defs/children"
        },
        "divided": {
          "type": "boolean"
        },
        "empty": {
          "$ref": "#/$defs/value"
        },
        "items": {
          "$ref": "#/$defs/collectionBinding"
        },
        "type": {
          "const": "list"
        }
      },
      "required": [
        "type",
        "items",
        "children"
      ],
      "type": "object"
    },
    "metricNode": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "$ref": "#/$defs/value"
        },
        "label": {
          "$ref": "#/$defs/value"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "type": {
          "const": "metric"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "required": [
        "type",
        "label",
        "value"
      ],
      "type": "object"
    },
    "nativeRender": {
      "additionalProperties": false,
      "properties": {
        "density": {
          "enum": [
            "compact",
            "standard",
            "comfortable"
          ]
        },
        "kind": {
          "const": "native"
        },
        "root": {
          "$ref": "#/$defs/node"
        }
      },
      "required": [
        "kind",
        "root"
      ],
      "type": "object"
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/stackNode"
        },
        {
          "$ref": "#/$defs/rowNode"
        },
        {
          "$ref": "#/$defs/sectionNode"
        },
        {
          "$ref": "#/$defs/textNode"
        },
        {
          "$ref": "#/$defs/keyValueNode"
        },
        {
          "$ref": "#/$defs/statusNode"
        },
        {
          "$ref": "#/$defs/metricNode"
        },
        {
          "$ref": "#/$defs/progressNode"
        },
        {
          "$ref": "#/$defs/donutNode"
        },
        {
          "$ref": "#/$defs/sparklineNode"
        },
        {
          "$ref": "#/$defs/listNode"
        },
        {
          "$ref": "#/$defs/tableNode"
        },
        {
          "$ref": "#/$defs/imageNode"
        },
        {
          "$ref": "#/$defs/videoNode"
        },
        {
          "$ref": "#/$defs/inputNode"
        },
        {
          "$ref": "#/$defs/buttonNode"
        },
        {
          "$ref": "#/$defs/dividerNode"
        },
        {
          "$ref": "#/$defs/spacerNode"
        }
      ]
    },
    "numberListValue": {
      "oneOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 120,
          "minItems": 2,
          "type": "array"
        },
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "numberValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fallback": {
              "type": "number"
            },
            "format": {
              "enum": [
                "number",
                "percent"
              ]
            },
            "path": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "progressNode": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "$ref": "#/$defs/value"
        },
        "label": {
          "$ref": "#/$defs/value"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "type": {
          "const": "progress"
        },
        "value": {
          "$ref": "#/$defs/numberValue"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "type": "object"
    },
    "projectionSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "projection"
        },
        "method": {
          "$ref": "https://octopus.local/schemas/projection_read_contract.schema.json#/$defs/clientSurfaceProjectionReadMethod"
        },
        "params": {
          "additionalProperties": true,
          "type": "object"
        },
        "path": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "method"
      ],
      "type": "object"
    },
    "rowNode": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "children": {
          "$ref": "#/$defs/children"
        },
        "gap": {
          "enum": [
            "none",
            "xs",
            "sm",
            "md",
            "lg"
          ]
        },
        "justify": {
          "enum": [
            "start",
            "center",
            "end",
            "between"
          ]
        },
        "type": {
          "const": "row"
        },
        "wrap": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "children"
      ],
      "type": "object"
    },
    "sandboxRender": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/action"
          },
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "type": "object"
        },
        "css": {
          "maxLength": 131072,
          "type": "string"
        },
        "html": {
          "maxLength": 262144,
          "minLength": 1,
          "type": "string"
        },
        "initial_height": {
          "maximum": 1600,
          "minimum": 80,
          "type": "integer"
        },
        "javascript": {
          "maxLength": 131072,
          "type": "string"
        },
        "kind": {
          "const": "sandbox"
        }
      },
      "required": [
        "kind",
        "html"
      ],
      "type": "object"
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "sectionNode": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "$ref": "#/$defs/children"
        },
        "glyph": {
