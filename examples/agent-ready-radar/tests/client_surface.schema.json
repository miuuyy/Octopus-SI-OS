          "enum": [
            "reflow",
            "scale"
          ]
        },
        "max_height": {
          "maximum": 720,
          "minimum": 80,
          "type": "integer"
        },
        "max_width": {
          "maximum": 960,
          "minimum": 120,
          "type": "integer"
        },
        "min_height": {
          "maximum": 720,
          "minimum": 80,
          "type": "integer"
        },
        "min_width": {
          "maximum": 960,
          "minimum": 120,
          "type": "integer"
        },
        "preferred_height": {
          "maximum": 720,
          "minimum": 80,
          "type": "integer"
        },
        "preferred_width": {
          "maximum": 960,
          "minimum": 120,
          "type": "integer"
        }
      },
