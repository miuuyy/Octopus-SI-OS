        "label": {
          "$ref": "#/$defs/value"
        },
        "state": {
          "$ref": "#/$defs/value"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "type": {
          "const": "status"
        }
      },
      "required": [
        "type",
        "label"
      ],
      "type": "object"
    },
    "tableColumn": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "key": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/value"
        },
        "role": {
          "enum": [
            "text",
            "number",
            "mono"
          ]
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "required": [
        "key",
        "label",
        "value"
      ],
      "type": "object"
    },
    "tableNode": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/tableColumn"
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array"
        },
        "empty": {
          "$ref": "#/$defs/value"
        },
        "rows": {
          "$ref": "#/$defs/collectionBinding"
        },
        "type": {
          "const": "table"
        }
      },
      "required": [
        "type",
        "rows",
        "columns"
      ],
      "type": "object"
    },
    "textNode": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "title",
            "body",
            "caption",
            "mono"
          ]
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "truncate": {
          "type": "boolean"
        },
        "type": {
          "const": "text"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "type": "object"
    },
    "tone": {
      "enum": [
        "default",
        "muted",
        "positive",
        "warning",
        "danger",
        "accent"
      ]
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fallback": {
              "$ref": "#/$defs/scalar"
            },
            "format": {
              "enum": [
                "text",
                "number",
                "percent",
                "date",
                "time",
                "json"
              ]
            },
            "path": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "videoNode": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "maxLength": 2048,
          "pattern": "^https://",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "video"
        }
      },
      "required": [
        "type",
        "source"
      ],
      "type": "object"
    },
