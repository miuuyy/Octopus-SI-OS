          "minimum": -1000,
          "type": "integer"
        },
        "surface_id": {
          "$ref": "#/$defs/id"
        },
        "worker_environment_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind",
        "worker_environment_id",
        "surface_id",
        "order"
      ],
      "type": "object"
    },
    "workspaceTarget": {
      "additionalProperties": false,
      "properties": {
        "chrome": {
          "additionalProperties": false,
          "properties": {
            "search_placeholder": {
              "maxLength": 96,
              "minLength": 1,
              "type": "string"
            },
            "titlebar_glyph": {
              "$ref": "#/$defs/glyph"
            },
            "topbar": {
              "enum": [
                "wide",
                "none"
              ]
            },
            "workspace": {
              "enum": [
                "panel",
                "immersive"
              ]
            }
          },
          "required": [
            "topbar",
            "workspace"
          ],
          "type": "object"
        },
        "kind": {
          "const": "workspace.surface"
        },
        "order": {
          "maximum": 10000,
          "minimum": -1000,
          "type": "integer"
        },
        "placements": {
          "items": {
            "enum": [
              "shell",
              "home"
            ]
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "placements",
        "order",
        "chrome"
      ],
      "type": "object"
    }
  },
  "$id": "https://octopus.local/schemas/client_surface_document.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object"
