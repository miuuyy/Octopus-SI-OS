        "order": {
          "maximum": 1000,
          "minimum": -1000,
          "type": "integer"
        },
        "slot": {
          "enum": [
            "left",
            "right"
          ]
        }
      },
      "required": [
        "kind",
        "slot",
        "order",
        "layout"
      ],
