      ],
      "type": "object"
    },
    "stackNode": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "children": {
          "$ref": "#/$defs/children"
        },
