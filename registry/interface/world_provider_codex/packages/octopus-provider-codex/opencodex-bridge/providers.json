      "icon": "gemini-color.svg",
      "input_modalities": ["text", "image"],
      "vertex": {
        "location": "global",
        "project": { "env": "OCTOPUS_PROVIDER_VERTEX_PROJECT", "label": "Google Cloud project ID" },
        "credentials": { "env": "OCTOPUS_PROVIDER_VERTEX_CREDENTIALS_FILE", "label": "Credentials file: path to a service account key or application default credentials JSON" }
