{
  "name": "octopus-opencodex-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/prepare-upstream.mjs && node ./scripts/run-bun.mjs build --compile ./src/main.ts --outfile ./bin/octopus-opencodex-bridge --metafile=./node_modules/.cache/octopus-opencodex-bridge/metafile.json && node ./scripts/write-build-receipt.mjs",
    "test": "npm run build && node ./scripts/run-bun.mjs test ./tests",
    "postinstall": "node ./scripts/prepare-upstream.mjs"
  },
  "dependencies": {
    "@bitkyc08/opencodex": "2.100.1",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "bun": "1.4.4"
  },
  "allowScripts": {
    "bun@1.4.4": true
  }
}
