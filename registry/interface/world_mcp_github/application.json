{
  "schema_version": 3,
  "id": "world_mcp_github",
  "name": "GitHub",
  "description": "Work with your GitHub repositories, code, issues, pull requests and workflows.",
  "category": "plugin",
  "developer": "Octopus",
  "version": "1.1.0",
  "icon": "github",
  "logo": "application-logo.svg",
  "interfaces": [
    "world_mcp_github"
  ],
  "artifact_bindings": [
    {
      "artifact_id": "artifact-application-mcp-github-context",
      "label": "GitHub capability contract"
    }
  ],
  "task_capabilities": {
    "tools": [
      {
        "tool": "artifact.send",
        "interface": "system_room",
        "worker_environment_kind": "system_room"
      }
    ]
  },
  "setup": {
    "fields": [
      {
        "interface": "world_mcp_github",
        "pointer": "/interface_driver_config/transport/auth_env_key",
        "label": "GitHub access token",
        "kind": "secret",
        "required": true,
        "placeholder": "github_pat_\u2026"
      }
    ]
  },
  "connection": {
    "disclosure": [
      "Tasks you connect can read and act on GitHub with your token's access.",
      "Fine-grained tokens limit it to the repositories and permissions you choose.",
      "The token stays on this Mac, readable only by the GitHub interface."
    ],
    "help": {
      "label": "Create a GitHub token",
      "url": "https://github.com/settings/personal-access-tokens/new"
    }
  }
}
