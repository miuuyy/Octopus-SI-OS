        "required": true
      },
      {
        "interface": "world_provider_custom",
        "pointer": "/interface_driver_config/transport/base_url_env",
        "label": "Server URL ending in /v1",
        "kind": "url",
        "required": true
      },
      {
        "interface": "world_provider_custom",
        "pointer": "/interface_driver_config/private_config/opencodex/model_env",
        "label": "Model id",
        "kind": "text",
        "required": true
      }
    ]
  }
