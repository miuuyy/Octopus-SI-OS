{
  "schema_version": 3,
  "id": "world_provider_custom",
  "name": "Custom OpenAI-compatible",
  "description": "Any server that speaks the OpenAI Chat Completions API.",
  "category": "provider",
  "developer": "Octopus",
  "version": "1.0.0",
  "icon": "sparkles",
  "logo": "application-logo.svg",
