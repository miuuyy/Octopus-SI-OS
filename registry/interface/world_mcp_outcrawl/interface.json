{
  "id": "world_mcp_outcrawl",
  "interface_type": "world",
  "role": "service",
  "direction": "bidirectional",
  "source_names": [
    "mcp"
  ],
  "interface_driver_ref": "mcp_client",
  "interface_driver_config": {
    "private_config": {
      "protocol_versions": [
        "2025-11-25",
        "2025-06-18",
        "2025-03-26"
      ],
      "client_name": "octopus-mcp-client",
      "client_version": "1",
      "operation_catalog_dir": "operations",
      "operation_catalog_label": "mcp.operation_catalog",
      "operation_request_label": "mcp.operation.request",
      "operator_approval": true,
      "max_catalog_pages": 64,
      "max_catalog_items": 4096,
      "max_catalog_bytes": 16777216,
      "event_journal_segment_bytes": 16777216,
      "event_journal_retained_segments": 64,
      "reconnect_backoff_ms": 2000,
      "account_profile": {
        "request": "https://api.outcrawl.ai/v1/credits",
        "label": "Your Outcrawl workspace",
        "via": "your Outcrawl API key",
        "manage": {
          "label": "Manage API keys in Outcrawl",
          "url": "https://outcrawl.ai/console/keys"
        }
      },
      "client_connection": {
        "schema_version": 1,
        "module": "interface://world_mcp_example/packages/octopus-mcp-client/connection.cjs"
      },
      "server_tool_operations": {
        "prefix": "outcrawl"
      }
    },
    "transport": {
      "base_url": "https://api.outcrawl.ai/mcp",
      "wire": "mcp_streamable_http",
      "auth_env_key": "WORLD_MCP_OUTCRAWL_BEARER",
      "request_timeout_ms": 120000,
      "max_response_bytes": 8388608
    }
  }
}
