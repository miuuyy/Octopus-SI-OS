{
  "id": "outcrawl.send_progress",
  "request_label": "mcp.operation.request",
  "output_label": "mcp.result",
  "handler_config": {
    "operation": "send_progress"
  },
  "description": "Send a progress notification for a token supplied by the bound remote MCP peer.",
  "input_schema": {
    "type": "object",
    "properties": {
      "progress_token": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "number"
          }
        ]
      },
      "progress": {
        "type": "number",
        "minimum": 0
      },
      "total": {
        "type": "number",
        "minimum": 0
      },
      "message": {
        "type": "string"
      }
    },
    "required": [
      "progress_token",
      "progress"
    ],
    "additionalProperties": false
  }
}
