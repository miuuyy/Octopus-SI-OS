{
  "id": "outcrawl.respond",
  "request_label": "mcp.operation.request",
  "output_label": "mcp.result",
  "handler_config": {
    "operation": "respond"
  },
  "description": "Return a JSON-RPC result or error for a server request previously emitted by remote MCP event polling.",
  "input_schema": {
    "type": "object",
    "properties": {
      "request_id": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "minLength": 1
          }
        ]
      },
      "result": {},
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "data": {}
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "request_id"
    ],
    "oneOf": [
      {
        "required": [
          "result"
        ]
      },
      {
        "required": [
          "error"
        ]
      }
    ],
    "additionalProperties": false
  }
}
