{
  "id": "email.mark_messages",
  "request_label": "email.operation.request",
  "output_label": "email.operation.result",
  "handler_config": {
    "operation": "message.mark",
    "read_only": false
  },
  "description": "Mark messages read or unread, flagged or unflagged. Give exactly one of ref or refs, and seen, flagged or both.",
  "input_schema": {
    "type": "object",
    "properties": {
      "ref": {
        "type": "object",
        "properties": {
          "mailbox": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uidvalidity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "uid": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "required": [
          "mailbox",
          "uidvalidity",
          "uid"
        ],
        "additionalProperties": false,
        "description": "message.ref from an email.event or a search result."
      },
      "refs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 500,
        "items": {
          "type": "object",
          "properties": {
            "mailbox": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "uidvalidity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "uid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          "required": [
            "mailbox",
            "uidvalidity",
            "uid"
          ],
          "additionalProperties": false
        },
        "description": "Several message refs from one mailbox."
      },
      "seen": {
        "type": "boolean"
      },
      "flagged": {
        "type": "boolean"
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
