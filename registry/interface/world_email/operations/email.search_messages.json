{
  "id": "email.search_messages",
  "request_label": "email.operation.request",
  "output_label": "email.operation.result",
  "handler_config": {
    "operation": "message.search",
    "read_only": true
  },
  "description": "Search a folder and return the newest matching messages with their refs, senders, subjects, dates and flags.",
  "input_schema": {
    "type": "object",
    "properties": {
      "mailbox": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "description": "Folder to search; INBOX by default. Roles such as \\Sent work too."
      },
      "from": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "to": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "subject": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "description": "Words anywhere in the message."
      },
      "since": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "On or after this date, YYYY-MM-DD."
      },
      "before": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Before this date, YYYY-MM-DD."
      },
      "unseen": {
        "type": "boolean"
      },
      "flagged": {
        "type": "boolean"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Most messages to return; 20 by default."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
