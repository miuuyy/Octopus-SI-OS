{
  "processes": [
    {
      "bin": "python3",
      "io_limits": {
        "max_control_frame_bytes": 1048576,
        "max_stderr_bytes": 262144,
        "max_manifest_bytes": 1048576,
        "max_payload_bytes": 268435456
      },
      "args": [
        {
          "repository_file": "registry/interface/world_telegram/telegram_life.py"
        }
      ],
      "required_files": [
        "registry/interface/world_telegram/telegram_life.py",
        "registry/interface/world_telegram/telegram_boundary.py",
        "registry/interface/world_telegram/telegram_contract.py",
        "registry/interface/world_telegram/telegram_render.py",
        "registry/interface/world_telegram/telegram_wire.py",
        "registry/interface/world_telegram/octopus_operation_catalog.py",
        "registry/interface/world_telegram/octopus_content_hash.py"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "inherit_env": [
        "OCTOPUS_TELEGRAM_API_BASE",
        "OCTOPUS_TELEGRAM_FALLBACK_IPS",
        "OCTOPUS_TELEGRAM_PROXY",
        "PATH",
        "TELEGRAM_ALLOWED_CHATS",
        "TELEGRAM_ALLOW_ALL_USERS",
        "TELEGRAM_FREE_RESPONSE_CHATS"
      ],
      "inherit_env_from_interface": [
        "/interface_driver_config/private_config/environment/bot_token_env",
        "/interface_driver_config/private_config/environment/allowed_user_ids_env",
        "/interface_driver_config/private_config/environment/home_chat_env"
      ],
      "required_env": [],
      "authority": {
        "read_root_slots": [
          "registry_interface_root"
        ],
        "write_root_slots": [],
        "executable_root_slots": [],
        "read_paths": [],
        "write_paths": [],
        "executable_paths": [],
        "executable_commands": [
          "python3"
        ],
        "read_env_paths": [],
        "write_env_paths": [],
        "executable_env_paths": [],
        "allow_network": true,
        "allow_local_ipc": true
      },
      "read_handles": [
        "ledger",
        "blobs",
        "ledger_index"
      ]
    }
  ]
}
