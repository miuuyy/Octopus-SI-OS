{
  "id": "telegram.get_chat_member",
  "request_label": "telegram.operation.request",
  "output_label": "telegram.operation.result",
  "handler_config": {
    "operation": "bot_api",
    "method": "getChatMember",
    "read_only": true
  },
  "description": "Read one person's membership in a chat: creator, administrator, member, restricted, left or kicked.",
  "input_schema": {
    "type": "object",
    "properties": {
      "chat_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^(@[A-Za-z][A-Za-z0-9_]{3,31}|-?[1-9][0-9]{0,15})$"
          }
        ],
        "description": "Chat: chat.id from a telegram.event, or a public @username."
      },
      "user_id": {
        "type": "integer",
        "minimum": 1,
        "description": "Telegram user id, such as from.id of an event."
      }
    },
    "required": [
      "chat_id",
      "user_id"
    ],
    "additionalProperties": false
  }
}
