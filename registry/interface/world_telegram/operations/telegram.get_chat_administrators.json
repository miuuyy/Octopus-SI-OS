{
  "id": "telegram.get_chat_administrators",
  "request_label": "telegram.operation.request",
  "output_label": "telegram.operation.result",
  "handler_config": {
    "operation": "bot_api",
    "method": "getChatAdministrators",
    "read_only": true
  },
  "description": "List the administrators of a group or channel with their rights.",
  "input_schema": {
    "type": "object",
    "properties": {
      "chat_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^(@[A-Za-z][A-Za-z0-9_]{3,31}|-?[1-9][0-9]{0,15})$"
          }
        ],
        "description": "Chat: chat.id from a telegram.event, or a public @username."
      }
    },
    "required": [
      "chat_id"
    ],
    "additionalProperties": false
  }
}
