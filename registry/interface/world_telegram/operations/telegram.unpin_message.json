{
  "id": "telegram.unpin_message",
  "request_label": "telegram.operation.request",
  "output_label": "telegram.operation.result",
  "handler_config": {
    "operation": "bot_api",
    "method": "unpinChatMessage",
    "read_only": false
  },
  "description": "Unpin a message, or the most recently pinned one when message_id is omitted.",
  "input_schema": {
    "type": "object",
    "properties": {
      "chat_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^(@[A-Za-z][A-Za-z0-9_]{3,31}|-?[1-9][0-9]{0,15})$"
          }
        ],
        "description": "Chat: chat.id from a telegram.event, or a public @username."
      },
      "message_id": {
        "type": "integer",
        "minimum": 1,
        "description": "message_id from a telegram.event or from an earlier result."
      }
    },
    "required": [
      "chat_id"
    ],
    "additionalProperties": false
  }
}
