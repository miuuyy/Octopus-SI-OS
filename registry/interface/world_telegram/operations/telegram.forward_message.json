{
  "id": "telegram.forward_message",
  "request_label": "telegram.operation.request",
  "output_label": "telegram.operation.result",
  "handler_config": {
    "operation": "bot_api",
    "method": "forwardMessage",
    "read_only": false
  },
  "description": "Forward a message from one chat to another; the copy shows where it came from. Returns the new message.",
  "input_schema": {
    "type": "object",
    "properties": {
      "chat_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^(@[A-Za-z][A-Za-z0-9_]{3,31}|-?[1-9][0-9]{0,15})$"
          }
        ],
        "description": "Destination chat: chat.id or a public @username."
      },
      "from_chat_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^(@[A-Za-z][A-Za-z0-9_]{3,31}|-?[1-9][0-9]{0,15})$"
          }
        ],
        "description": "Chat the message is in."
      },
      "message_id": {
        "type": "integer",
        "minimum": 1,
        "description": "message_id from a telegram.event or from an earlier result."
      },
      "message_thread_id": {
        "type": "integer",
        "minimum": 1,
        "description": "Forum topic: topic_id from the telegram.event."
      },
      "disable_notification": {
        "type": "boolean",
        "description": "Deliver without a notification sound."
      }
    },
    "required": [
      "chat_id",
      "from_chat_id",
      "message_id"
    ],
    "additionalProperties": false
  }
}
