{
  "id": "slack.get_team",
  "request_label": "slack.operation.request",
  "output_label": "slack.operation.result",
  "handler_config": {
    "operation": "web_api",
    "method": "team.info",
    "read_only": true
  },
  "description": "Read the workspace's name, domain and icon.",
  "input_schema": {
    "type": "object",
    "properties": {
      "team_id": {
        "type": "string",
        "pattern": "^T[A-Z0-9]{8,32}$",
        "description": "Workspace: team_id from the slack.event. Needed only when this interface serves several workspaces."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
