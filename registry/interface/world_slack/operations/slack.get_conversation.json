{
  "id": "slack.get_conversation",
  "request_label": "slack.operation.request",
  "output_label": "slack.operation.result",
  "handler_config": {
    "operation": "web_api",
    "method": "conversations.info",
    "read_only": true
  },
  "description": "Read a conversation's details: name, topic, purpose, privacy and membership.",
  "input_schema": {
    "type": "object",
    "properties": {
      "channel": {
        "type": "string",
        "pattern": "^[CDG][A-Z0-9]{8,32}$",
        "description": "Conversation id: channel_id from a slack.event."
      },
      "include_num_members": {
        "type": "boolean"
      },
      "team_id": {
        "type": "string",
        "pattern": "^T[A-Z0-9]{8,32}$",
        "description": "Workspace: team_id from the slack.event. Needed only when this interface serves several workspaces."
      }
    },
    "required": [
      "channel"
    ],
    "additionalProperties": false
  }
}
