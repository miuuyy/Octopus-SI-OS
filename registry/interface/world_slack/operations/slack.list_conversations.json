{
  "id": "slack.list_conversations",
  "request_label": "slack.operation.request",
  "output_label": "slack.operation.result",
  "handler_config": {
    "operation": "web_api",
    "method": "conversations.list",
    "read_only": true
  },
  "description": "List conversations the bot can see.",
  "input_schema": {
    "type": "object",
    "properties": {
      "types": {
        "type": "string",
        "pattern": "^(public_channel|private_channel|mpim|im)(,(public_channel|private_channel|mpim|im))*$",
        "description": "Comma-separated kinds; public_channel by default."
      },
      "exclude_archived": {
        "type": "boolean"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "description": "Most items to return in one page."
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "description": "response_metadata.next_cursor from the previous page."
      },
      "team_id": {
        "type": "string",
        "pattern": "^T[A-Z0-9]{8,32}$",
        "description": "Workspace: team_id from the slack.event. Needed only when this interface serves several workspaces."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
