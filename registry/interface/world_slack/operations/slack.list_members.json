{
  "id": "slack.list_members",
  "request_label": "slack.operation.request",
  "output_label": "slack.operation.result",
  "handler_config": {
    "operation": "web_api",
    "method": "conversations.members",
    "read_only": true
  },
  "description": "List the member ids of a conversation.",
  "input_schema": {
    "type": "object",
    "properties": {
      "channel": {
        "type": "string",
        "pattern": "^[CDG][A-Z0-9]{8,32}$",
        "description": "Conversation id: channel_id from a slack.event."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "description": "Most items to return in one page."
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "description": "response_metadata.next_cursor from the previous page."
      },
      "team_id": {
        "type": "string",
        "pattern": "^T[A-Z0-9]{8,32}$",
        "description": "Workspace: team_id from the slack.event. Needed only when this interface serves several workspaces."
      }
    },
    "required": [
      "channel"
    ],
    "additionalProperties": false
  }
}
