{
  "id": "slack.add_bookmark",
  "request_label": "slack.operation.request",
  "output_label": "slack.operation.result",
  "handler_config": {
    "operation": "web_api",
    "method": "bookmarks.add",
    "read_only": false,
    "params": {
      "type": "link"
    }
  },
  "description": "Add a link bookmark to a conversation.",
  "input_schema": {
    "type": "object",
    "properties": {
      "channel_id": {
        "type": "string",
        "pattern": "^[CDG][A-Z0-9]{8,32}$",
        "description": "Conversation id: channel_id from a slack.event."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "link": {
        "type": "string",
        "pattern": "^https?://",
        "maxLength": 4096
      },
      "emoji": {
        "type": "string",
        "minLength": 1,
        "description": "Emoji such as :memo:."
      },
      "team_id": {
        "type": "string",
        "pattern": "^T[A-Z0-9]{8,32}$",
        "description": "Workspace: team_id from the slack.event. Needed only when this interface serves several workspaces."
      }
    },
    "required": [
      "channel_id",
      "title",
      "link"
    ],
    "additionalProperties": false
  }
}
