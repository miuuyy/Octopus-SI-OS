      "environment": {
        "bot_token_env": "SLACK_BOT_TOKEN",
        "app_token_env": "SLACK_APP_TOKEN",
        "allowed_user_ids_env": "SLACK_ALLOWED_USERS",
        "allowed_channel_ids_env": "SLACK_ALLOWED_CHANNELS",
        "home_channel_env": "SLACK_HOME_CHANNEL"
      },
      "client_connection": {
        "schema_version": 1,
        "module": "interface://world_slack/packages/connection.cjs"
      }
    }
  }
}
