{
  "id": "world_image_generation",
  "interface_type": "world",
  "role": "service",
  "direction": "bidirectional",
  "source_names": [
    "image_generation"
  ],
  "interface_driver_ref": "image_generation",
  "interface_driver_config": {
    "private_config": {
      "operation_catalog_dir": "operations",
      "operation_catalog_label": "image.operation_catalog",
      "operation_request_label": "image.operation.request",
      "prompt_field": "prompt",
      "model": "gpt-image-2",
      "size": "auto",
      "quality": "auto",
      "background": "opaque",
      "data_path": "data",
      "b64_field": "b64_json",
      "url_field": "url",
      "allow_endpoint_origin": true,
      "allowed_url_origins": [],
      "media_label": "image.generated",
      "max_image_bytes": 33554432,
      "auth": {
        "mode": "chatgpt_account",
        "auth_file_env": "OCTOPUS_MACHINE_CODEX_AUTH_FILE",
        "account_header": "ChatGPT-Account-ID"
      },
      "account_check": {
        "url": "https://chatgpt.com/backend-api/wham/usage",
        "email_field": "email",
        "account_field": "account_id",
        "plan_field": "plan_type",
        "excluded_plans": [
          "free"
        ],
        "manage": {
          "label": "Manage in ChatGPT",
          "url": "https://chatgpt.com/settings/usage"
        }
      },
      "client_connection": {
        "schema_version": 1,
        "module": "interface://world_image_generation/packages/octopus-image-generation-interface/connection.cjs"
      }
    },
    "transport": {
      "base_url": "https://chatgpt.com/backend-api/codex/images/generations",
      "wire": "image_json_http",
      "headers": {
        "originator": "octopus_desktop"
      },
      "request_timeout_ms": 300000,
      "max_response_bytes": 50331648
    }
  }
}
