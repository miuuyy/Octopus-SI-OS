  "source_contract": {
    "writer": "Only configured native Session records a GUID found in its actual DownloadManager; native row is copied before asynchronous DB work. Missing/live-destroyed GUID cannot create a row. Session private directory cannot retarget.",
    "reader": "session.openOwnedDownloadHistory exact canonical owner0700 directory returns opaque main-only history handle without creating a Session/WebContents. Shared isolate owner per exact path prevents reopening/crash-normalizing an active writer. Reader close does not close another reader/writer.",
    "database": "Pinned Chromium DownloadDatabase and sql::Database History tag, native GUID/state/path/bytes/URL chain/slices, transactional owned metadata. No Chrome Profile cast or testing-only HistoryService. Existing native IN_PROGRESS rows become crash-interrupted only on DB opening; history does not recreate native DownloadItems or requests.",
    "shutdown": "OnBeforeMicrotasksRunnerDispose from the canonical Electron Chromium series rejects pending callbacks while V8 can settle them, resets sequenced DB after queued writes. UI/main callback handles never resolve directly from the DB thread.",
    "native_methods": [
      "Session.configureOwnedDownloadHistory(directory)",
      "Session.recordOwnedDownloadHistory(actualGUID,metadataJSON)",
      "DownloadItem.getGUID()",
      "session.openOwnedDownloadHistory(directory)->reader",
      "reader.search({text,offset,maxResults})",
      "reader.update(existingGUID,metadataJSON)",
      "reader.remove(existingGUID)",
      "reader.clear()",
      "reader.flush()",
      "reader.close()"
    ],
    "query": "ONE entire nonempty UTF16 term, Chromium primary case/accent comparison over original/final raw+formatted URLs and actual target display path; valid UTF8 native basename comparison. Source matches connected installed owner/predicate branches; native compile/locale runtime remains unproved.",
    "source_only_limits": [
      "Pinned fragment apply is not full canonical checkout composition, C++ compilation, ABI or native acceptance.",
      "Exact package observer now consumes native GUID/Session/history-reader APIs in source. No native compilation/execution or legacy JSON/native conversion has occurred; prior data requires its explicit owner decision before activation.",
      "SQL private sidecar permissions/durable restart and isolate shutdown require the authored native spec and later native acceptance."
    ]
  },
  "native_check": {
    "title": "retains actual download GUID and SQLite rows across a fresh engine process without recreating a page",
    "spec": "electron/spec/api-owned-guest-spec.ts",
    "execution": "held"
  },
