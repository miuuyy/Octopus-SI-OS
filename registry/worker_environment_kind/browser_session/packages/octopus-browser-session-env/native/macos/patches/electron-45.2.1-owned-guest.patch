+namespace electron::api {
+namespace {
+auto& Leases() {
+  static base::NoDestructor<
+      std::map<std::string, base::WeakPtr<OwnedGuestPresentation>>> leases;
+  return *leases;
+}
+
+content::RenderFrameHost* ResolveFrame(WebContents* embedder,
+                                      const std::string& frame_token) {
+  if (!embedder || !embedder->web_contents())
+    return nullptr;
+  auto token = base::Token::FromString(frame_token);
+  if (!token)
+    return nullptr;
+  auto value = base::UnguessableToken::Deserialize(token->high(), token->low());
+  if (!value)
+    return nullptr;
+  content::RenderFrameHost* result = nullptr;
+  embedder->web_contents()->ForEachRenderFrameHost(
+      [&](content::RenderFrameHost* frame) {
+        if (frame->GetFrameToken() == blink::LocalFrameToken(*value))
+          result = frame;
+      });
+  if (!result || !result->GetParent() || !result->IsRenderFrameLive() ||
+      result->GetMainFrame() != embedder->web_contents()->GetPrimaryMainFrame() ||
+      content::WebContents::FromRenderFrameHost(result) != embedder->web_contents())
+    return nullptr;
+  return result;
+}
+}
+
+class OwnedGuestPresentation::EmbedderObserver
+    : public content::WebContentsObserver {
+ public:
+  EmbedderObserver(base::WeakPtr<OwnedGuestPresentation> owner,
+                   content::WebContents* embedder, int generation, bool pending)
+      : content::WebContentsObserver(embedder), owner_(owner),
+        generation_(generation), pending_(pending) {}
+  void WebContentsDestroyed() override { Gone(); }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    Gone();
+  }
+  void PrimaryPageChanged(content::Page&) override { Gone(); }
+  void OnVisibilityChanged(content::Visibility) override {
+    if (owner_ && !pending_) owner_->UpdateVisibility();
+  }
+  void FrameDeleted(content::FrameTreeNodeId id) override {
+    if (owner_)
+      owner_->FrameGone(generation_, pending_, id);
+  }
+ private:
+  void Gone() {
+    if (owner_)
+      owner_->EmbedderGone(generation_, pending_);
+  }
+  base::WeakPtr<OwnedGuestPresentation> owner_;
+  int generation_;
+  bool pending_;
+};
+
+struct OwnedGuestPresentation::Lease {
+  std::string token;
+  std::string frame_token;
+  base::WeakPtr<WebContents> embedder;
+  content::FrameTreeNodeId frame;
+  content::GlobalRenderFrameHostId primary_frame;
+  int generation;
+  bool consumed = false;
+  std::unique_ptr<EmbedderObserver> observer;
+  std::unique_ptr<gin_helper::Promise<void>> promise;
+  base::RepeatingCallback<bool()> validate;
+  base::OnceClosure commit;
+};
+
+bool OwnedGuestPresentation::IsAvailable() {
+  return base::FeatureList::IsEnabled(features::kAttachUnownedInnerWebContents);
+}
+
+bool OwnedGuestPresentation::IsValidGeneration(double generation) {
+  return std::isfinite(generation) && generation > 0 &&
+         generation <= std::numeric_limits<int>::max() &&
+         std::floor(generation) == generation;
+}
+
+OwnedGuestPresentation::OwnedGuestPresentation(
+    WebContents* owner, const gfx::Size& initial_surface_size,
+    bool preserve_current_size)
+    : owner_(owner), last_surface_size_(initial_surface_size) {
+  CHECK(IsAvailable());
+  CHECK(!initial_surface_size.IsEmpty());
+  auto* contents = owner_->web_contents();
+  CHECK(contents);
+  CHECK(!contents->GetOuterWebContents());
+  guest_contents::GuestContentsHandle::CreateForWebContents(contents);
+  if (preserve_current_size)
+    RememberSurfaceSize(contents);
+  RestoreSurfaceSize(contents, preserve_current_size);
+}
+
+void OwnedGuestPresentation::RememberSurfaceSize(content::WebContents* contents) {
+  auto* view = contents->GetRenderWidgetHostView();
+  auto size = view ? view->GetViewBounds().size() : gfx::Size();
+  if (size.IsEmpty() && !contents->GetOuterWebContents())
+    size = contents->GetSize();
+  if (!size.IsEmpty())
+    last_surface_size_ = size;
+}
+
+void OwnedGuestPresentation::RestoreSurfaceSize(content::WebContents* contents,
+                                                 bool preserve_widget_size) {
+  const auto can_resize = [&] {
+    return !stopped_ && contents && owner_->web_contents() == contents &&
+           !contents->IsBeingDestroyed() && !contents->GetOuterWebContents() &&
+           !current_generation_ && !owner_->attached_ && !owner_->embedder_;
+  };
+  if (!can_resize())
+    return;
+  auto self = weak_factory_.GetWeakPtr();
+  auto* view = contents->GetRenderWidgetHostView();
+  const auto widget_size = preserve_widget_size && view
+                               ? view->GetViewBounds().size() : gfx::Size();
+  contents->Resize(gfx::Rect(last_surface_size_));
+  if (self && can_resize() && !widget_size.IsEmpty() &&
+      contents->GetRenderWidgetHostView() == view) {
+    view->SetSize(widget_size);
+  }
+}
+
+OwnedGuestPresentation::~OwnedGuestPresentation() { Shutdown(); }
+
+bool OwnedGuestPresentation::Matches(WebContents* embedder,
+                                     const std::string& frame_token) const {
+  if (stopped_ || !lease_ || !lease_->embedder ||
+      lease_->embedder.get() != embedder || lease_->frame_token != frame_token ||
+      !owner_->web_contents() || !embedder->web_contents())
+    return false;
+  auto* primary = embedder->web_contents()->GetPrimaryMainFrame();
+  auto* frame = ResolveFrame(embedder, frame_token);
+  return primary && primary->GetGlobalId() == lease_->primary_frame && frame &&
+         frame->GetFrameTreeNodeId() == lease_->frame;
+}
+
+WebContents* OwnedGuestPresentation::FindLease(const std::string& token,
+                                               WebContents* embedder,
+                                               const std::string& frame_token, double generation) {
+  if (!IsValidGeneration(generation)) return nullptr;
+  auto it = Leases().find(token);
+  if (it == Leases().end() || !it->second ||
+      !it->second->Matches(embedder, frame_token) || it->second->lease_->consumed ||
+      it->second->lease_->generation != generation)
+    return nullptr;
+  return it->second->owner_;
+}
+
+std::string OwnedGuestPresentation::CreateLease(WebContents* embedder,
+                                                const std::string& frame_token,
+                                                int generation) {
+  if (stopped_ || !IsAvailable() || generation <= last_generation_ ||
+      !owner_->web_contents() || embedder == owner_)
+    return {};
+  auto* frame = ResolveFrame(embedder, frame_token);
+  if (!frame)
+    return {};
+  if (current_embedder_ && current_embedder_->web_contents() &&
+      current_embedder_->web_contents()->GetBrowserContext() !=
+          embedder->web_contents()->GetBrowserContext())
+    return {};
+  CancelPending("Presentation lease superseded");
+  lease_ = std::make_unique<Lease>();
+  lease_->token = base::UnguessableToken::Create().ToString();
+  lease_->frame_token = frame_token;
+  lease_->embedder = embedder->GetWeakPtr();
+  lease_->frame = frame->GetFrameTreeNodeId();
+  lease_->primary_frame = embedder->web_contents()->GetPrimaryMainFrame()->GetGlobalId();
+  lease_->generation = generation;
+  last_generation_ = generation;
+  lease_->observer = std::make_unique<EmbedderObserver>(
+      weak_factory_.GetWeakPtr(), embedder->web_contents(), generation, true);
+  Leases().emplace(lease_->token, weak_factory_.GetWeakPtr());
+  lease_timer_.Start(FROM_HERE, base::Seconds(60), base::BindOnce(
+      &OwnedGuestPresentation::CancelPending, weak_factory_.GetWeakPtr(),
+      "Presentation lease expired"));
+  return lease_->token;
+}
+
+v8::Local<v8::Promise> OwnedGuestPresentation::Attach(
+    v8::Isolate* isolate, const std::string& token, WebContents* embedder,
+    const std::string& frame_token, base::RepeatingCallback<bool()> validate,
+    base::OnceClosure commit) {
+  gin_helper::Promise<void> promise(isolate);
+  auto result = promise.GetHandle();
+  if (!Matches(embedder, frame_token) || lease_->token != token ||
+      lease_->consumed || !validate || !commit) {
+    promise.RejectWithErrorMessage("Invalid or consumed presentation lease");
+    return result;
+  }
+  lease_->consumed = true;
+  Leases().erase(token);
+  lease_->promise = std::make_unique<gin_helper::Promise<void>>(std::move(promise));
+  lease_->validate = std::move(validate);
+  lease_->commit = std::move(commit);
+  auto* frame = ResolveFrame(embedder, frame_token);
+  frame->PrepareForInnerWebContentsAttach(base::BindOnce(
+      &OwnedGuestPresentation::Prepared, weak_factory_.GetWeakPtr(),
+      lease_->generation));
+  return result;
+}
+
+void OwnedGuestPresentation::Prepared(int generation,
+                                      content::RenderFrameHost* frame) {
+  if (!lease_ || lease_->generation != generation)
+    return;
+  auto destination = lease_->embedder;
+  if (!destination || !destination->web_contents() || !frame ||
+      frame->GetFrameTreeNodeId() != lease_->frame || !frame->IsRenderFrameLive() ||
+      !frame->GetParent() || content::WebContents::FromRenderFrameHost(frame) !=
+                                  destination->web_contents() ||
+      destination->web_contents()->GetPrimaryMainFrame()->GetGlobalId() !=
+          lease_->primary_frame) {
+    CancelPending("Destination frame changed before attachment");
+    return;
+  }
+  const auto prepared_id = frame->GetGlobalId();
+  auto self = weak_factory_.GetWeakPtr();
+  auto validate = lease_->validate;
+  if (!validate.Run()) {
+    if (self)
+      CancelPending("Presentation binding changed before attachment");
+    return;
+  }
+  if (!self || !lease_ || lease_->generation != generation)
+    return;
+  frame = content::RenderFrameHost::FromID(prepared_id);
+  if (!frame || !destination || !destination->web_contents() ||
+      content::WebContents::FromRenderFrameHost(frame) != destination->web_contents()) {
+    CancelPending("Destination disappeared during binding validation");
+    return;
+  }
+  Detach(true);
+  if (!self || !lease_ || lease_->generation != generation)
+    return;
+  frame = content::RenderFrameHost::FromID(prepared_id);
+  if (!frame || !destination || !destination->web_contents() ||
+      !frame->IsRenderFrameLive()) {
+    CancelPending("Page retained without presentation: destination disappeared");
+    return;
+  }
+  auto* handle = guest_contents::GuestContentsHandle::FromWebContents(owner_->web_contents());
+  handle->AttachToOuterWebContents(frame);
+  if (!self) return;
+  if (!lease_ || lease_->generation != generation) {
+    Detach(false);
+    return;
+  }
+  if (!destination || owner_->web_contents()->GetOuterWebContents() !=
+                          destination->web_contents()) {
+    Detach(false);
+    if (self)
+      CancelPending("Page retained without presentation: native attachment failed");
+    return;
+  }
+  current_embedder_ = destination;
+  current_frame_ = lease_->frame;
+  current_generation_ = generation;
+  owner_->embedder_ = destination.get();
+  owner_->attached_ = true;
+  presentation_visible_ = false;
+  auto* relay = NativeWindowRelay::FromWebContents(destination->web_contents());
+  owner_->SetOwnerWindow(relay ? relay->GetNativeWindow() : nullptr);
+  if (!self) return;
+  if (!lease_ || lease_->generation != generation || !destination) {
+    Detach(false);
+    return;
+  }
+  current_observer_ = std::make_unique<EmbedderObserver>(
+      self, destination->web_contents(), generation, false);
+  owner_->web_contents()->WasHidden();
+  if (!self) return;
+  if (!lease_ || lease_->generation != generation) {
+    Detach(false);
+    return;
+  }
+  lease_timer_.Stop();
+  auto completed = std::move(lease_);
+  completed->observer.reset();
+  std::move(completed->commit).Run();
+  if (!self || current_generation_ != generation) {
+    completed->promise->RejectWithErrorMessage("Page presentation withdrawn during commit");
+    return;
+  }
+  completed->promise->Resolve();
+  if (self) owner_->Emit("did-attach");
+}
+
+void OwnedGuestPresentation::CancelPending(const std::string& reason) {
+  if (!lease_)
+    return;
+  lease_timer_.Stop();
+  auto canceled = std::move(lease_);
+  Leases().erase(canceled->token);
+  canceled->observer.reset();
+  if (canceled->promise)
+    canceled->promise->RejectWithErrorMessage(reason);
+}
+
+bool OwnedGuestPresentation::Cancel(const std::string& token) {
+  if (!lease_ || lease_->token != token)
+    return false;
+  CancelPending("Presentation lease canceled");
+  return true;
+}
+
+void OwnedGuestPresentation::Detach(bool notify) {
+  auto self = weak_factory_.GetWeakPtr();
+  auto* contents = owner_->web_contents();
+  auto* old_outer = contents ? contents->GetOuterWebContents() : nullptr;
+  if (contents && !contents->IsBeingDestroyed())
+    RememberSurfaceSize(contents);
+  const int old_generation = current_generation_;
+  current_generation_ = 0;
+  presentation_visible_ = false;
+  current_observer_.reset();
+  current_embedder_.reset();
+  current_frame_ = content::FrameTreeNodeId();
+  owner_->embedder_ = nullptr;
+  owner_->attached_ = false;
+  if (contents)
+    owner_->SetOwnerWindow(nullptr);
+  if (!self) return;
+  if (contents && owner_->web_contents() == contents && !current_generation_ &&
+      contents->GetOuterWebContents() == old_outer) {
+    contents->WasHidden();
+    if (!self) return;
+    if (owner_->web_contents() == contents && !current_generation_ &&
+        contents->GetOuterWebContents() == old_outer) {
+      auto* handle = guest_contents::GuestContentsHandle::FromWebContents(contents);
+      if (handle)
+        handle->DetachFromOuterWebContents();
+      if (!self) return;
+      RestoreSurfaceSize(contents, true);
+    }
+  }
+  if (self && notify && old_generation)
+    owner_->Emit("-owned-guest-released", old_generation);
+}
+
+bool OwnedGuestPresentation::Release(int generation) {
+  if (generation != current_generation_ || generation <= 0)
+    return false;
+  Detach(true);
+  return true;
+}
+
+void OwnedGuestPresentation::EmbedderGone(int generation, bool pending) {
+  if (pending) {
+    if (lease_ && lease_->generation == generation)
+      CancelPending("Destination embedder was withdrawn");
+  } else if (current_generation_ == generation) {
+    Release(generation);
+  }
+}
+
+void OwnedGuestPresentation::FrameGone(int generation, bool pending,
+                                      content::FrameTreeNodeId id) {
+  if ((pending && lease_ && lease_->generation == generation && lease_->frame == id) ||
+      (!pending && current_generation_ == generation && current_frame_ == id))
+    EmbedderGone(generation, pending);
+}
+
+void OwnedGuestPresentation::SetPaintLease(bool enabled) {
+  if (stopped_ || !owner_->web_contents())
+    return;
+  paint_requested_ = enabled;
+  if (!enabled) {
+    paint_lease_.RunAndReset();
+  } else if (!paint_lease_ && !paint_acquiring_) {
+    paint_acquiring_ = true;
+    auto self = weak_factory_.GetWeakPtr();
+    auto lease = owner_->web_contents()->IncrementCapturerCount(gfx::Size(), true, false, false);
+    if (self) {
+      paint_acquiring_ = false;
+      if (!stopped_ && paint_requested_)
+        paint_lease_ = std::move(lease);
+    }
+  }
+}
+
+bool OwnedGuestPresentation::SetVisibility(int generation, bool visible) {
+  if (stopped_ || generation <= 0 || generation != current_generation_)
+    return false;
+  presentation_visible_ = visible;
+  UpdateVisibility();
+  return true;
+}
+
+void OwnedGuestPresentation::UpdateVisibility() {
+  if (stopped_ || !owner_->web_contents()) return;
+  const bool visible = presentation_visible_ && current_embedder_ &&
+      current_embedder_->web_contents() &&
+      current_embedder_->web_contents()->GetVisibility() == content::Visibility::VISIBLE;
+  if (visible)
+    owner_->web_contents()->WasShown();
+  else
+    owner_->web_contents()->WasHidden();
+}
+
+void OwnedGuestPresentation::Shutdown() {
+  if (stopped_)
+    return;
+  stopped_ = true;
+  CancelPending("Owned browser page closed");
+  Detach(false);
+  paint_lease_.RunAndReset();
+  weak_factory_.InvalidateWeakPtrs();
+}
+}
diff --git a/electron/shell/browser/api/owned_guest_presentation.h b/electron/shell/browser/api/owned_guest_presentation.h
new file mode 100644
--- /dev/null
+++ b/electron/shell/browser/api/owned_guest_presentation.h
@@ -0,0 +1,80 @@
+#ifndef ELECTRON_SHELL_BROWSER_API_OWNED_GUEST_PRESENTATION_H_
+#define ELECTRON_SHELL_BROWSER_API_OWNED_GUEST_PRESENTATION_H_
+
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "content/public/browser/frame_tree_node_id.h"
+#include "shell/common/gin_helper/promise.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace content {
+class RenderFrameHost;
+class WebContents;
+}
+namespace electron::api {
+class WebContents;
+
+class OwnedGuestPresentation {
+ public:
+  OwnedGuestPresentation(WebContents* owner, const gfx::Size& initial_surface_size,
+                         bool preserve_current_size);
+  ~OwnedGuestPresentation();
+  static bool IsAvailable();
+  static bool IsValidGeneration(double generation);
+  static WebContents* FindLease(const std::string& token,
+                                WebContents* embedder,
+                                const std::string& frame_token, double generation);
+  std::string CreateLease(WebContents* embedder,
+                          const std::string& frame_token,
+                          int generation);
+  v8::Local<v8::Promise> Attach(v8::Isolate* isolate,
+                               const std::string& token,
+                               WebContents* embedder,
+                               const std::string& frame_token,
+                               base::RepeatingCallback<bool()> validate,
+                               base::OnceClosure commit);
+  bool Cancel(const std::string& token);
+  bool Release(int generation);
+  void SetPaintLease(bool enabled);
+  bool SetVisibility(int generation, bool visible);
+  void Shutdown();
+
+ private:
+  class EmbedderObserver;
+  struct Lease;
+  bool Matches(WebContents* embedder, const std::string& frame_token) const;
+  void Prepared(int generation, content::RenderFrameHost* frame);
+  void CancelPending(const std::string& reason);
+  void Detach(bool notify);
+  void RememberSurfaceSize(content::WebContents* contents);
+  void RestoreSurfaceSize(content::WebContents* contents,
+                          bool preserve_widget_size);
+  void UpdateVisibility();
+  void EmbedderGone(int generation, bool pending);
+  void FrameGone(int generation, bool pending,
+                 content::FrameTreeNodeId frame_id);
+
+  raw_ptr<WebContents> owner_;
+  gfx::Size last_surface_size_;
+  std::unique_ptr<Lease> lease_;
+  std::unique_ptr<EmbedderObserver> current_observer_;
+  base::WeakPtr<WebContents> current_embedder_;
+  content::FrameTreeNodeId current_frame_;
+  int current_generation_ = 0;
+  int last_generation_ = 0;
+  bool stopped_ = false;
+  bool presentation_visible_ = false;
+  bool paint_requested_ = false;
+  bool paint_acquiring_ = false;
+  base::ScopedClosureRunner paint_lease_;
+  base::OneShotTimer lease_timer_;
+  base::WeakPtrFactory<OwnedGuestPresentation> weak_factory_{this};
+};
+}
+#endif
diff --git a/electron/spec/api-owned-guest-spec.ts b/electron/spec/api-owned-guest-spec.ts
new file mode 100644
--- /dev/null
+++ b/electron/spec/api-owned-guest-spec.ts
@@ -0,0 +1,232 @@
+import { strict as assert } from 'node:assert';
+import { createHash, randomUUID } from 'node:crypto';
+import { BrowserWindow, nativeImage, session, webContents } from 'electron';
+
+type Guest = Electron.WebContents & {
+  createOwnedGuestLease(embedder: Electron.WebContents, frameToken: string, generation: number): string;
+  cancelOwnedGuestLease(token: string): boolean;
+  releaseOwnedGuest(generation: number): boolean;
+  setOwnedGuestPaintLease(enabled: boolean): void;
+  setOwnedGuestVisibility(generation: number, visible: boolean): boolean;
+};
+const factory = webContents as unknown as {
+  createOwnedGuest(options: Electron.WebPreferences & { session: Electron.Session; initialSurfaceSize: {width: number; height: number} }): Guest;
+};
+
+describe('owned guest presentation', function () {
+  this.timeout(30000);
+  let guest: Guest;
+  const windows: BrowserWindow[] = [];
+  async function outer() {
+    const window = new BrowserWindow({ show: false, webPreferences: {
+      sandbox: true, contextIsolation: true, nodeIntegration: false, webviewTag: true
+    } });
+    windows.push(window);
+    await window.loadURL('data:text/html,' + encodeURIComponent(
+      '<main style="width:400px;height:240px;overflow:hidden">' +
+      '<webview id="page" style="width:1280px;height:720px;transform:scale(.5);transform-origin:0 0"></webview></main>'));
+    const token = await window.webContents.executeJavaScript('document.getElementById("page").getOwnedGuestFrameToken()');
+    return { window, token };
+  }
+  async function attach(destination: Awaited<ReturnType<typeof outer>>, generation: number) {
+    destination.token = await destination.window.webContents.executeJavaScript(
+      'document.getElementById("page").getOwnedGuestFrameToken()');
+    const token = guest.createOwnedGuestLease(destination.window.webContents, destination.token, generation);
+    assert.ok(token);
+    await destination.window.webContents.executeJavaScript(
+      `document.getElementById("page").adoptOwnedGuest(${JSON.stringify(token)}, ${generation})`);
+    return token;
+  }
+  beforeEach(() => {
+    guest = factory.createOwnedGuest({ session: session.fromPartition(`owned-${randomUUID()}`),
+      sandbox: true, nodeIntegration: false, contextIsolation: true,
+      initialSurfaceSize: { width: 1280, height: 720 } });
+  });
+  afterEach(() => {
+    if (guest && !guest.isDestroyed()) guest.destroy();
+    for (const window of windows.splice(0)) if (!window.isDestroyed()) window.destroy();
+  });
+
+  it('retains one document, Session and debugger through transfer and embedder destruction', async () => {
+    guest.debugger.attach('1.3');
+    await guest.loadURL('about:blank');
+    await guest.executeJavaScript('globalThis.identity = { count: 41 }; history.pushState({n:1}, "")');
+    const id = guest.id;
+    const roomSession = guest.session;
+    const a = await outer();
+    await attach(a, 1);
+    const b = await outer();
+    await attach(b, 2);
+    assert.equal(guest.id, id);
+    assert.equal(guest.session, roomSession);
+    assert.ok(guest.debugger.isAttached());
+    assert.equal(await guest.executeJavaScript('++identity.count'), 42);
+    assert.equal(await guest.executeJavaScript('history.state.n'), 1);
+    assert.equal(guest.releaseOwnedGuest(1), false);
+    a.window.destroy();
+    assert.equal(guest.hostWebContents, b.window.webContents);
+    b.window.destroy();
+    assert.equal(guest.isDestroyed(), false);
+    assert.equal(guest.hostWebContents, null);
+    const c = await outer();
+    await attach(c, 3);
+    assert.equal(await guest.executeJavaScript('identity.count'), 42);
+    assert.equal(guest.releaseOwnedGuest(3), true);
+    await attach(c, 4);
+    assert.equal(await guest.executeJavaScript('identity.count'), 42);
+  });
+
+  it('rejects wrong frame/embedder, consumed lease and cancellation without changing page', async () => {
+    const a = await outer();
+    const b = await outer();
+    for (const invalid of [NaN, 1.25, 2 ** 32 + 1]) {
+      assert.equal(guest.createOwnedGuestLease(a.window.webContents, a.token, invalid), '');
+    }
+    const token = guest.createOwnedGuestLease(a.window.webContents, a.token, 1);
+    await assert.rejects(b.window.webContents.executeJavaScript(
+      `document.getElementById("page").adoptOwnedGuest(${JSON.stringify(token)}, 1)`));
+    assert.equal(guest.cancelOwnedGuestLease(token), true);
+    await assert.rejects(a.window.webContents.executeJavaScript(
+      `document.getElementById("page").adoptOwnedGuest(${JSON.stringify(token)}, 1)`));
+    assert.equal(guest.isDestroyed(), false);
+    const liveToken = await attach(a, 2);
+    assert.equal(guest.cancelOwnedGuestLease(liveToken), false);
+    assert.equal(guest.createOwnedGuestLease(b.window.webContents, b.token, 2), '');
+    assert.equal(guest.hostWebContents, a.window.webContents);
+    b.window.webContents.once('did-attach-webview', () => guest.releaseOwnedGuest(3));
+    await assert.rejects(attach(b, 3));
+    assert.equal(guest.isDestroyed(), false);
+    await attach(b, 4);
+    assert.equal(guest.hostWebContents, b.window.webContents);
+  });
+
+  it('retains the exact native popup with its opener Session and independent lifetime', async () => {
+    let accept!: (child: Guest) => void;
+    const opened = new Promise<Guest>(resolve => { accept = resolve; });
+    guest.setWindowOpenHandler(() => ({ action: 'allow', outlivesOpener: true,
+      createWindow: options => {
+        const child = options.webContents as Guest;
+        assert.ok(child);
+        accept(child);
+        return child;
+      }
+    }));
+    await guest.loadURL('about:blank');
+    const roomSession = guest.session;
+    await guest.executeJavaScript('window.open("about:blank").retainedPopupValue = 17');
+    const child = await opened;
+    assert.equal(child.session, roomSession);
+    assert.equal(await child.executeJavaScript('retainedPopupValue'), 17);
+    guest.destroy();
+    guest = child;
+    assert.equal(child.isDestroyed(), false);
+    const destination = await outer();
+    await attach(destination, 1);
+    assert.equal(await child.executeJavaScript('retainedPopupValue'), 17);
+  });
+
+  it('captures before DOM or emulation, then retains the same sized page after detach', async () => {
+    const id = guest.id;
+    const roomSession = guest.session;
+    const windowIds = BrowserWindow.getAllWindows().map(window => window.id);
+    guest.setOwnedGuestPaintLease(true);
+    guest.debugger.attach('1.3');
+    await guest.loadURL('data:text/html,<html><body style="margin:0"></body></html>');
+    await guest.executeJavaScript('globalThis.retainedIdentity = 37');
+    const dimensions = await guest.executeJavaScript(
+      '({width:innerWidth,height:innerHeight,dpr:devicePixelRatio,hidden:document.hidden})');
+    assert.equal(dimensions.width, 1280);
+    assert.equal(dimensions.height, 720);
+    assert.equal(dimensions.hidden, true);
+    assert.equal(guest.hostWebContents, null);
+    const capture = async (color: string, width: number, height: number) => {
+      await guest.executeJavaScript(`document.documentElement.style.background=${JSON.stringify(color)};` +
+        'new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)))');
+      const result = await guest.debugger.sendCommand('Page.captureScreenshot', {
+        format: 'png', fromSurface: true, captureBeyondViewport: false
+      });
+      const image = nativeImage.createFromBuffer(Buffer.from(result.data, 'base64'));
+      const dpr = await guest.executeJavaScript('devicePixelRatio');
+      assert.deepEqual(image.getSize(), { width: Math.round(width * dpr), height: Math.round(height * dpr) });
+      const pixel = image.toBitmap().subarray(0, 4);
+      assert.equal(pixel[3], 255);
+      return pixel;
+    };
+    const first = await capture('rgb(220,20,40)', 1280, 720);
+    const second = await capture('rgb(20,200,60)', 1280, 720);
+    assert.notDeepEqual(first.subarray(0, 3), second.subarray(0, 3));
+    assert.deepEqual(BrowserWindow.getAllWindows().map(window => window.id), windowIds);
+    const destination = await outer();
+    await attach(destination, 1);
+    assert.equal(guest.releaseOwnedGuest(1), true);
+    assert.equal(guest.id, id);
+    assert.equal(guest.session, roomSession);
+    assert.equal(guest.hostWebContents, null);
+    assert.equal(await guest.executeJavaScript('retainedIdentity'), 37);
+    assert.deepEqual(await guest.executeJavaScript('[innerWidth,innerHeight]'), [1280, 720]);
+    await capture('rgb(40,60,220)', 1280, 720);
+    await guest.debugger.sendCommand('Emulation.setDeviceMetricsOverride', {
+      width: 640, height: 360, deviceScaleFactor: 1, mobile: false
+    });
+    await attach(destination, 2);
+    assert.equal(guest.releaseOwnedGuest(2), true);
+    assert.deepEqual(await guest.executeJavaScript('[innerWidth,innerHeight]'), [640, 360]);
+    await capture('rgb(200,160,40)', 640, 360);
+    assert.equal(destination.window.isVisible(), false);
+    assert.equal(destination.window.isFocused(), false);
+  });
+
+  it('keeps the model viewport and captures fresh hidden native frames without showing an owner', async () => {
+    guest.debugger.attach('1.3');
+    guest.setOwnedGuestPaintLease(true);
+    await guest.loadURL('about:blank');
+    await guest.debugger.sendCommand('Emulation.setDeviceMetricsOverride', {
+      width: 1280, height: 720, deviceScaleFactor: 1, mobile: false
+    });
+    const a = await outer();
+    await attach(a, 1);
+    assert.equal(guest.setOwnedGuestVisibility(1, false), true);
+    assert.deepEqual(await guest.executeJavaScript('[innerWidth, innerHeight]'), [1280, 720]);
+    const hashes: string[] = [];
+    for (const color of ['rgb(200,20,40)', 'rgb(20,200,40)']) {
+      await guest.executeJavaScript(`document.body.style.background=${JSON.stringify(color)};` +
+        'new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)))');
+      const capture = await guest.debugger.sendCommand('Page.captureScreenshot', { format: 'png' });
+      hashes.push(createHash('sha256').update(Buffer.from(capture.data, 'base64')).digest('hex'));
+    }
+    assert.notEqual(hashes[0], hashes[1]);
+    assert.equal(a.window.isVisible(), false);
+    assert.equal(a.window.isFocused(), false);
+    assert.equal(await guest.executeJavaScript('document.visibilityState'), 'hidden');
+    guest.setOwnedGuestPaintLease(false);
+  });
+  it('retains the crashed WebContents and replaces only its diagnostic history entry', async () => {
+    await guest.loadURL('data:text/html,' + encodeURIComponent('<title>Earlier page</title><p>Earlier</p>'));
+    await guest.loadURL('data:text/html,' + encodeURIComponent('<title>Failed page</title><p>Failed</p>'));
+    const id = guest.id;
+    const roomSession = guest.session;
+    const entries = guest.navigationHistory.getAllEntries();
+    const before = guest.navigationHistory.getActiveIndex();
+    assert.ok(before > 0);
+    const crashed = new Promise<void>(resolve => guest.once('render-process-gone', () => resolve()));
+    guest.forcefullyCrashRenderer();
+    await crashed;
+    assert.equal(guest.isDestroyed(), false);
+    const diagnostic = 'data:text/html;charset=utf-8,' + encodeURIComponent('<title>This page crashed</title><p>Diagnostic</p>');
+    const options: Electron.LoadURLOptions & { replaceCurrentEntry: boolean } = { replaceCurrentEntry: true };
+    await guest.loadURL(diagnostic, options);
+    assert.equal(guest.id, id);
+    assert.equal(guest.session, roomSession);
+    assert.equal(await guest.executeJavaScript('location.href'), diagnostic);
+    assert.equal(guest.navigationHistory.getActiveIndex(), before);
+    assert.equal(guest.navigationHistory.getAllEntries().length, entries.length);
+    assert.equal(guest.navigationHistory.getAllEntries()[before].url, diagnostic);
+    await new Promise<void>(resolve => {
+      guest.once('did-finish-load', () => resolve());
+      guest.navigationHistory.goBack();
+    });
+    assert.equal(guest.getURL(), entries[before - 1].url);
+    assert.equal(guest.id, id);
+  });
+
+});
