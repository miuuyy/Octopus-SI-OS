+using Result = OwnedDownloadHistory::Result;
+Result Error(std::string message) { return {.error = std::move(message)}; }
+Result Done() { Result result; result.value.Set("ok", true); return result; }
+bool ValidMetadata(const std::string& metadata) {
+  return metadata.size() <= 16 * 1024 * 1024 &&
+         base::JSONReader::ReadDict(metadata, base::JSON_PARSE_RFC).has_value();
+}
+history::DownloadRow NativeRow(download::DownloadItem* item) {
+  history::DownloadRow row;
+  row.guid = item->GetGuid();
+  row.current_path = item->GetFullPath();
+  row.target_path = item->GetTargetFilePath();
+  row.url_chain = item->GetUrlChain();
+  row.referrer_url = item->GetReferrerUrl();
+  row.embedder_download_data = item->GetSerializedEmbedderDownloadData();
+  row.tab_url = item->GetTabUrl();
+  row.tab_referrer_url = item->GetTabReferrerUrl();
+  row.mime_type = item->GetMimeType();
+  row.original_mime_type = item->GetOriginalMimeType();
+  row.start_time = item->GetStartTime();
+  row.end_time = item->GetEndTime();
+  row.etag = item->GetETag();
+  row.last_modified = item->GetLastModifiedTime();
+  row.received_bytes = item->GetReceivedBytes();
+  row.total_bytes = item->GetTotalBytes();
+  row.state = history::ToHistoryDownloadState(item->GetState());
+  row.danger_type = history::ToHistoryDownloadDangerType(item->GetDangerType());
+  row.interrupt_reason = history::ToHistoryDownloadInterruptReason(item->GetLastReason());
+  row.hash = item->GetHash();
+  row.opened = item->GetOpened();
+  row.last_access_time = item->GetLastAccessTime();
+  row.transient = item->IsTransient();
+  row.download_slice_info = history::GetHistoryDownloadSliceInfos(*item);
+  return row;
+}
+bool MatchesQuery(const history::DownloadRow& row, const std::u16string& needle) {
+  if (needle.empty()) return true;
+  const auto contains = [&needle](const std::u16string& candidate) {
+    return base::i18n::StringSearchIgnoringCaseAndAccents(needle, candidate, nullptr, nullptr);
+  };
+  if (!row.url_chain.empty()) {
+    const auto& first = row.url_chain.front();
+    const auto& last = row.url_chain.back();
+    if (contains(base::UTF8ToUTF16(first.spec())) || contains(url_formatter::FormatUrl(first)) ||
+        contains(base::UTF8ToUTF16(last.spec())) || contains(url_formatter::FormatUrl(last))) return true;
+  }
+  if (contains(row.target_path.LossyDisplayName())) return true;
+  const auto filename = row.target_path.BaseName().value();
+  return base::IsStringUTF8(filename) && contains(base::UTF8ToUTF16(filename));
+}
+std::string State(history::DownloadState state) {
+  switch (state) {
+    case history::DownloadState::IN_PROGRESS: return "in_progress";
+    case history::DownloadState::COMPLETE: return "complete";
+    case history::DownloadState::CANCELLED: return "canceled";
+    case history::DownloadState::INTERRUPTED: return "interrupted";
+    default: return "invalid";
+  }
+}
+}
+
+class OwnedDownloadHistory::Database : private history::DownloadDatabase {
+ public:
+  explicit Database(const base::FilePath& directory)
+      : history::DownloadDatabase(
+            history::ToHistoryDownloadInterruptReason(download::DOWNLOAD_INTERRUPT_REASON_NONE),
+            history::ToHistoryDownloadInterruptReason(download::DOWNLOAD_INTERRUPT_REASON_CRASH)),
+        db_("History") {
+    struct stat root{};
+    if (!directory.IsAbsolute() || base::MakeAbsoluteFilePath(directory) != directory ||
+        lstat(directory.value().c_str(), &root) || !S_ISDIR(root.st_mode) ||
+        root.st_uid != getuid() || (root.st_mode & 0777) != 0700) {
+      error_ = "Native download history requires a canonical private owner directory";
+      return;
+    }
+    const auto file = directory.AppendASCII("history.sqlite");
+    struct stat old{};
+    const bool exists = lstat(file.value().c_str(), &old) == 0;
+    if ((!exists && errno != ENOENT) ||
+        (exists && (!S_ISREG(old.st_mode) || old.st_uid != getuid() || (old.st_mode & 0777) != 0600))) {
+      error_ = "Native download history is not a private regular file";
+      return;
+    }
+    db_.set_error_callback(base::BindRepeating(
+        [](Database* owner, int code, sql::Statement*) {
+          owner->error_ = "Native download database error " + base::NumberToString(code);
+        }, base::Unretained(this)));
+    if (!db_.Open(file) || !base::SetPosixFilePermissions(file, 0600)) {
+      error_ = "Native download history could not be opened";
+      return;
+    }
+    if (exists) {
+      if (!db_.DoesTableExist("owned_history_version")) {
+        error_ = "Native download history does not identify its owned schema";
+        return;
+      }
+      sql::Statement version(db_.GetUniqueStatement("SELECT version FROM owned_history_version"));
+      if (!version.Step() || version.ColumnInt(0) != 1 || version.Step() || !version.Succeeded()) {
+        error_ = "Native download history schema differs";
+        return;
+      }
+    }
+    sql::Transaction transaction(&db_);
+    if (!transaction.Begin() || !InitDownloadTable() ||
+        (!exists && (!db_.Execute("CREATE TABLE owned_history_version(version INTEGER NOT NULL)") ||
+                     !db_.Execute("INSERT INTO owned_history_version VALUES(1)") ||
+                     !db_.Execute("CREATE TABLE owned_download_metadata(guid TEXT PRIMARY KEY NOT NULL, data TEXT NOT NULL, filename TEXT NOT NULL)") ||
+                     !db_.Execute("CREATE UNIQUE INDEX owned_download_guid ON downloads(guid)"))) ||
+        !db_.DoesTableExist("owned_download_metadata") || !transaction.Commit()) {
+      error_ = "Native download history schema could not be initialized";
+      return;
+    }
+    std::vector<history::DownloadRow> rows;
+    QueryDownloads(&rows);
+  }
+  ~Database() { db_.reset_error_callback(); }
+  Result Ready() { return error_.empty() ? Done() : Error(error_); }
+  Result Record(history::DownloadRow row, std::string filename, std::string metadata) {
+    if (!error_.empty()) return Error(error_);
+    if (row.guid.empty() || !ValidMetadata(metadata)) return Error("Native download metadata is invalid");
+    sql::Transaction transaction(&db_);
+    if (!transaction.Begin()) return Error("Native download transaction could not start");
+    const auto existing = Find(row.guid);
+    if (!error_.empty()) return Error(error_);
+    row.id = existing ? *existing : history::ToHistoryDownloadId(GetNextDownloadId());
+    if (row.id == history::kInvalidDownloadId || !(existing ? UpdateDownload(row) : CreateDownload(row)))
+      return Error("Native download row could not be saved");
+    sql::Statement metadata_write(db_.GetUniqueStatement(
+        "INSERT INTO owned_download_metadata(guid,data,filename) VALUES(?,?,?) "
+        "ON CONFLICT(guid) DO UPDATE SET data=excluded.data,filename=excluded.filename"));
+    metadata_write.BindString(0, row.guid);
+    metadata_write.BindString(1, metadata);
+    metadata_write.BindString(2, filename);
+    if (!metadata_write.Run() || !transaction.Commit()) return Error("Native download metadata could not be saved");
+    return Ready();
+  }
+  Result Update(std::string guid, std::string metadata) {
+    if (!error_.empty()) return Error(error_);
+    if (!ValidMetadata(metadata) || !Find(guid)) return Error("Native download metadata has no recorded GUID");
+    sql::Statement update(db_.GetUniqueStatement("UPDATE owned_download_metadata SET data=? WHERE guid=?"));
+    update.BindString(0, metadata); update.BindString(1, guid);
+    if (!update.Run() || db_.GetLastChangeCount() != 1) return Error("Native download metadata changed owner");
+    return Ready();
+  }
+  Result Search(std::string text, int offset, int limit) {
+    if (!error_.empty()) return Error(error_);
+    if (offset < 0 || limit < 0 || text.size() > 16 * 1024 * 1024) return Error("Native history query is invalid");
+    std::vector<history::DownloadRow> rows;
+    QueryDownloads(&rows);
+    if (!error_.empty()) return Error(error_);
+    std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) {
+      return a.start_time != b.start_time ? a.start_time > b.start_time : a.guid < b.guid;
+    });
+    std::map<std::string, std::pair<std::string, std::string>> metadata_rows;
+    sql::Statement data(db_.GetUniqueStatement("SELECT guid,data,filename FROM owned_download_metadata"));
+    while (data.Step()) {
+      const auto guid = data.ColumnString(0), metadata = data.ColumnString(1);
+      if (guid.empty() || !ValidMetadata(metadata) || !metadata_rows.emplace(guid, std::make_pair(metadata, data.ColumnString(2))).second)
+        return Error("Stored native download metadata is invalid");
+    }
+    if (!data.Succeeded() || metadata_rows.size() != rows.size()) return Error("Native download history row ownership differs");
+    const auto needle = base::i18n::ToLower(base::UTF8ToUTF16(text));
+    base::ListValue output;
+    size_t skipped = 0;
+    bool more = false;
+    for (const auto& row : rows) {
+      auto found = metadata_rows.find(row.guid);
+      if (found == metadata_rows.end()) return Error("Native download row has no owned metadata");
+      const auto& [metadata, filename] = found->second;
+      if (!MatchesQuery(row, needle)) continue;
+      if (skipped++ < static_cast<size_t>(offset)) continue;
+      if (limit && output.size() >= static_cast<size_t>(limit)) { more = true; break; }
+      if (!ValidMetadata(metadata)) return Error("Stored native download metadata is invalid");
+      base::DictValue native;
+      native.Set("guid", row.guid); native.Set("filename", filename); native.Set("state", State(row.state));
+      native.Set("received_bytes", base::NumberToString(row.received_bytes));
+      native.Set("total_bytes", base::NumberToString(row.total_bytes));
+      native.Set("interrupt_reason", base::NumberToString(row.interrupt_reason));
+      native.Set("current_path", row.current_path.AsUTF8Unsafe()); native.Set("target_path", row.target_path.AsUTF8Unsafe());
+      native.Set("started_at_ms", row.start_time.InMillisecondsFSinceUnixEpoch());
+      native.Set("ended_at_ms", row.end_time.InMillisecondsFSinceUnixEpoch());
+      base::ListValue chain; for (const auto& url : row.url_chain) chain.Append(url.spec());
+      native.Set("url_chain", std::move(chain));
+      base::DictValue record; record.Set("native", std::move(native)); record.Set("metadata", metadata);
+      output.Append(std::move(record));
+    }
+    if (!error_.empty()) return Error(error_);
+    Result result; result.value.Set("text", text); result.value.Set("offset", offset);
+    result.value.Set("hasMore", more); result.value.Set("records", std::move(output)); return result;
+  }
+  Result Remove(std::string guid) {
+    if (!error_.empty()) return Error(error_);
+    const auto id = Find(guid);
+    if (!error_.empty()) return Error(error_);
+    if (!id) { Result result; result.value.Set("removed", false); return result; }
+    sql::Statement state(db_.GetUniqueStatement("SELECT state FROM downloads WHERE id=?"));
+    state.BindInt64(0, history::DownloadIdToInt(*id));
+    if (!state.Step() || state.ColumnInt(0) == history::DownloadStateToInt(history::DownloadState::IN_PROGRESS))
+      return Error("Active native download cannot be removed from history");
+    sql::Transaction transaction(&db_);
+    if (!transaction.Begin()) return Error("Native history removal could not start");
+    RemoveDownload(*id);
+    sql::Statement remove(db_.GetUniqueStatement("DELETE FROM owned_download_metadata WHERE guid=?"));
+    remove.BindString(0, guid);
+    if (!remove.Run() || !error_.empty() || !transaction.Commit()) return Error("Native history removal was not committed");
+    Result result; result.value.Set("removed", true); return result;
+  }
+  Result Clear() {
+    if (!error_.empty()) return Error(error_);
+    std::vector<history::DownloadRow> rows; QueryDownloads(&rows);
+    sql::Transaction transaction(&db_);
+    if (!error_.empty() || !transaction.Begin()) return Error("Native history clear could not start");
+    uint32_t count = 0;
+    for (const auto& row : rows) {
+      if (row.state == history::DownloadState::IN_PROGRESS) continue;
+      RemoveDownload(row.id);
+      sql::Statement remove(db_.GetUniqueStatement("DELETE FROM owned_download_metadata WHERE guid=?"));
+      remove.BindString(0, row.guid);
+      if (!remove.Run() || !error_.empty()) return Error("Native history clear failed");
+      ++count;
+    }
+    if (!transaction.Commit()) return Error("Native history clear was not committed");
+    Result result; result.value.Set("removed", static_cast<double>(count)); return result;
+  }
+ private:
+  sql::Database& GetDB() override { return db_; }
+  std::optional<history::DownloadId> Find(const std::string& guid) {
+    sql::Statement statement(db_.GetUniqueStatement("SELECT id FROM downloads WHERE guid=?"));
+    statement.BindString(0, guid);
+    if (!statement.Step()) return std::nullopt;
+    history::DownloadId id;
+    if (!history::ConvertIntToDownloadId(statement.ColumnInt64(0), &id)) { error_ = "Native download history contains an invalid row identity"; return std::nullopt; }
+    return id;
+  }
+  sql::Database db_;
+  std::string error_;
+};
+
+OwnedDownloadHistory::OwnedDownloadHistory(const base::FilePath& directory)
+    : database_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE, base::TaskShutdownBehavior::BLOCK_SHUTDOWN}), directory) {}
+OwnedDownloadHistory::~OwnedDownloadHistory() { Shutdown(); }
+uint64_t OwnedDownloadHistory::Pending(Reply reply) {
+  if (replies_.size() >= 1024) { std::move(reply).Run(Error("Native download history request queue is full")); return 0; }
+  if (stopped_ || next_request_ == std::numeric_limits<uint64_t>::max()) {
+    std::move(reply).Run(Error("Native download history owner is closed")); return 0;
+  }
+  const uint64_t request = ++next_request_; replies_.emplace(request, std::move(reply)); return request;
+}
+void OwnedDownloadHistory::Complete(uint64_t request, Result result) {
+  auto found = replies_.find(request); if (found == replies_.end()) return;
+  auto reply = std::move(found->second); replies_.erase(found); std::move(reply).Run(std::move(result));
+}
+void OwnedDownloadHistory::Ready(Reply reply) {
+  auto request = Pending(std::move(reply)); if (!request) return;
+  database_.AsyncCall(&Database::Ready).Then(base::BindOnce(&OwnedDownloadHistory::Complete, weak_factory_.GetWeakPtr(), request));
+}
+void OwnedDownloadHistory::Record(download::DownloadItem* item, std::string metadata, Reply reply) {
+  if (!item) { std::move(reply).Run(Error("Native download item is no longer alive")); return; }
+  auto request = Pending(std::move(reply)); if (!request) return;
+  database_.AsyncCall(&Database::Record).WithArgs(NativeRow(item), item->GetFileNameToReportUser().AsUTF8Unsafe(), std::move(metadata))
+      .Then(base::BindOnce(&OwnedDownloadHistory::Complete, weak_factory_.GetWeakPtr(), request));
+}
+void OwnedDownloadHistory::Update(std::string guid, std::string metadata, Reply reply) {
+  auto request = Pending(std::move(reply)); if (!request) return;
+  database_.AsyncCall(&Database::Update).WithArgs(std::move(guid), std::move(metadata))
+      .Then(base::BindOnce(&OwnedDownloadHistory::Complete, weak_factory_.GetWeakPtr(), request));
+}
+void OwnedDownloadHistory::Search(std::string text, int offset, int limit, Reply reply) {
+  auto request = Pending(std::move(reply)); if (!request) return;
+  database_.AsyncCall(&Database::Search).WithArgs(std::move(text), offset, limit)
+      .Then(base::BindOnce(&OwnedDownloadHistory::Complete, weak_factory_.GetWeakPtr(), request));
+}
+void OwnedDownloadHistory::Remove(std::string guid, Reply reply) {
+  auto request = Pending(std::move(reply)); if (!request) return;
+  database_.AsyncCall(&Database::Remove).WithArgs(std::move(guid))
+      .Then(base::BindOnce(&OwnedDownloadHistory::Complete, weak_factory_.GetWeakPtr(), request));
+}
+void OwnedDownloadHistory::Clear(Reply reply) {
+  auto request = Pending(std::move(reply)); if (!request) return;
+  database_.AsyncCall(&Database::Clear).Then(base::BindOnce(&OwnedDownloadHistory::Complete, weak_factory_.GetWeakPtr(), request));
+}
+void OwnedDownloadHistory::Flush(Reply reply) { Ready(std::move(reply)); }
+void OwnedDownloadHistory::Shutdown() {
+  if (stopped_) return;
+  stopped_ = true; weak_factory_.InvalidateWeakPtrs();
+  auto replies = std::move(replies_);
+  for (auto& [request, reply] : replies) std::move(reply).Run(Error("Native download history owner closed before confirmation"));
+  database_.Reset();
+}
+}
