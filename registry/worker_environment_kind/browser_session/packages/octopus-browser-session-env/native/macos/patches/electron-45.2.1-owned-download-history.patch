+#ifndef ELECTRON_SHELL_BROWSER_API_OWNED_DOWNLOAD_HISTORY_H_
+#define ELECTRON_SHELL_BROWSER_API_OWNED_DOWNLOAD_HISTORY_H_
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/threading/sequence_bound.h"
+#include "base/values.h"
+
+namespace download { class DownloadItem; }
+namespace electron::api {
+class OwnedDownloadHistory {
+ public:
+  struct Result {
+    base::DictValue value;
+    std::string error;
+  };
+  using Reply = base::OnceCallback<void(Result)>;
+  explicit OwnedDownloadHistory(const base::FilePath& directory);
+  ~OwnedDownloadHistory();
+  void Ready(Reply reply);
+  void Record(download::DownloadItem* item, std::string metadata, Reply reply);
+  void Update(std::string guid, std::string metadata, Reply reply);
+  void Search(std::string text, int offset, int limit, Reply reply);
+  void Remove(std::string guid, Reply reply);
+  void Clear(Reply reply);
+  void Flush(Reply reply);
+  void Shutdown();
+
+ private:
+  class Database;
+  uint64_t Pending(Reply reply);
+  void Complete(uint64_t request, Result result);
+  base::SequenceBound<Database> database_;
+  std::map<uint64_t, Reply> replies_;
+  uint64_t next_request_ = 0;
+  bool stopped_ = false;
+  base::WeakPtrFactory<OwnedDownloadHistory> weak_factory_{this};
+};
+}
+#endif
diff --git a/electron/shell/browser/api/owned_download_history_binding.cc b/electron/shell/browser/api/owned_download_history_binding.cc
new file mode 100644
--- /dev/null
+++ b/electron/shell/browser/api/owned_download_history_binding.cc
@@ -0,0 +1,135 @@
+#include "shell/browser/api/owned_download_history_binding.h"
+
+#include <map>
+#include <memory>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "content/public/browser/browser_thread.h"
+#include "electron/buildflags/buildflags.h"
+#include "gin/arguments.h"
+#include "gin/per_isolate_data.h"
+#include "shell/browser/browser.h"
+#include "shell/common/gin_converters/value_converter.h"
+#include "shell/common/gin_helper/dictionary.h"
+
+namespace electron::api {
+namespace {
+class HistoryOwners final : public gin::PerIsolateData::DisposeObserver {
+ public:
+  explicit HistoryOwners(v8::Isolate* isolate) {
+    gin::PerIsolateData::From(isolate)->AddDisposeObserver(this);
+  }
+  static auto& All() {
+    static base::NoDestructor<std::map<v8::Isolate*, std::unique_ptr<HistoryOwners>>> owners;
+    return *owners;
+  }
+  void OnBeforeDispose(v8::Isolate*) override {}
+  void OnDisposed() override {}
+  void OnBeforeMicrotasksRunnerDispose(v8::Isolate* isolate) override {
+    closing = true;
+    for (auto& [directory, history] : histories) history->Shutdown();
+    histories.clear();
+    gin::PerIsolateData::From(isolate)->RemoveDisposeObserver(this);
+    All().erase(isolate);
+  }
+  bool closing = false;
+  std::map<base::FilePath, std::shared_ptr<OwnedDownloadHistory>> histories;
+};
+struct Reader {
+  std::shared_ptr<OwnedDownloadHistory> history;
+  bool closed = false;
+};
+using ReaderRef = std::shared_ptr<Reader>;
+using Promise = gin_helper::Promise<base::DictValue>;
+bool CheckReader(const ReaderRef& reader, Promise& promise) {
+  if (!reader->closed) return true;
+  promise.RejectWithErrorMessage("Native download history reader is closed");
+  return false;
+}
+v8::Local<v8::Promise> Search(ReaderRef reader, base::DictValue query,
+                              gin::Arguments* args) {
+  Promise promise(args->isolate()); auto handle = promise.GetHandle();
+  if (!CheckReader(reader, promise)) return handle;
+  const auto* text = query.FindString("text");
+  const auto offset = query.FindInt("offset"), limit = query.FindInt("maxResults");
+  if (query.size() != 3 || !text || !offset || !limit || *offset < 0 || *limit < 0) {
+    promise.RejectWithErrorMessage("Native download history query is invalid"); return handle;
+  }
+  reader->history->Search(*text, *offset, *limit, OwnedDownloadHistoryReply(std::move(promise)));
+  return handle;
+}
+v8::Local<v8::Promise> Update(ReaderRef reader, std::string guid,
+                              std::string metadata, gin::Arguments* args) {
+  Promise promise(args->isolate()); auto handle = promise.GetHandle();
+  if (CheckReader(reader, promise)) reader->history->Update(std::move(guid), std::move(metadata), OwnedDownloadHistoryReply(std::move(promise)));
+  return handle;
+}
+v8::Local<v8::Promise> Remove(ReaderRef reader, std::string guid,
+                              gin::Arguments* args) {
+  Promise promise(args->isolate()); auto handle = promise.GetHandle();
+  if (CheckReader(reader, promise)) reader->history->Remove(std::move(guid), OwnedDownloadHistoryReply(std::move(promise)));
+  return handle;
+}
+v8::Local<v8::Promise> Clear(ReaderRef reader, gin::Arguments* args) {
+  Promise promise(args->isolate()); auto handle = promise.GetHandle();
+  if (CheckReader(reader, promise)) reader->history->Clear(OwnedDownloadHistoryReply(std::move(promise)));
+  return handle;
+}
+v8::Local<v8::Promise> Flush(ReaderRef reader, gin::Arguments* args) {
+  Promise promise(args->isolate()); auto handle = promise.GetHandle();
+  if (CheckReader(reader, promise)) reader->history->Flush(OwnedDownloadHistoryReply(std::move(promise)));
+  return handle;
+}
+gin_helper::Dictionary ReaderObject(v8::Isolate* isolate, ReaderRef reader) {
+  auto object = gin_helper::Dictionary::CreateEmpty(isolate);
+  object.SetMethod("search", base::BindRepeating(&Search, reader));
+  object.SetMethod("update", base::BindRepeating(&Update, reader));
+  object.SetMethod("remove", base::BindRepeating(&Remove, reader));
+  object.SetMethod("clear", base::BindRepeating(&Clear, reader));
+  object.SetMethod("flush", base::BindRepeating(&Flush, reader));
+  object.SetMethod("close", base::BindRepeating([](ReaderRef owner) { owner->closed = true; }, reader));
+  return object;
+}
+}
+
+std::shared_ptr<OwnedDownloadHistory> AcquireOwnedDownloadHistory(
+    v8::Isolate* isolate, const base::FilePath& directory) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!BUILDFLAG(ENABLE_OWNED_GUEST_EMBEDDER)) return nullptr;
+  auto& owner = HistoryOwners::All()[isolate];
+  if (!owner) owner = std::make_unique<HistoryOwners>(isolate);
+  if (owner->closing) return nullptr;
+  auto& history = owner->histories[directory];
+  if (!history) history = std::make_shared<OwnedDownloadHistory>(directory);
+  return history;
+}
+OwnedDownloadHistory::Reply OwnedDownloadHistoryReply(Promise promise) {
+  return base::BindOnce([](Promise value, OwnedDownloadHistory::Result result) {
+    if (!result.error.empty()) value.RejectWithErrorMessage(result.error);
+    else value.Resolve(result.value);
+  }, std::move(promise));
+}
+v8::Local<v8::Promise> OpenOwnedDownloadHistory(
+    const base::FilePath& directory, gin::Arguments* args) {
+  gin_helper::Promise<gin_helper::Dictionary> promise(args->isolate());
+  auto handle = promise.GetHandle();
+  if (!electron::Browser::Get()->is_ready()) {
+    promise.RejectWithErrorMessage("Native download history requires app readiness"); return handle;
+  }
+  auto reader = std::make_shared<Reader>();
+  reader->history = AcquireOwnedDownloadHistory(args->isolate(), directory);
+  if (!reader->history) { promise.RejectWithErrorMessage("Owned download history engine is unavailable"); return handle; }
+  reader->history->Ready(base::BindOnce(
+      [](ReaderRef reader, gin_helper::Promise<gin_helper::Dictionary> value,
+         OwnedDownloadHistory::Result result) {
+        if (!result.error.empty()) { value.RejectWithErrorMessage(result.error); return; }
+        v8::HandleScope scope(value.isolate());
+        v8::Context::Scope context(value.GetContext());
+        value.Resolve(ReaderObject(value.isolate(), std::move(reader)));
+      }, reader, std::move(promise)));
+  return handle;
+}
+}
