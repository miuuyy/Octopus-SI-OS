@@ -0,0 +1,182 @@
+#include "shell/browser/api/owned_navigation_history_binding.h"
+
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <memory>
+#include <set>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/uuid.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/query_parser/query_parser.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/web_contents.h"
+#include "electron/buildflags/buildflags.h"
+#include "gin/arguments.h"
+#include "gin/per_isolate_data.h"
+#include "shell/browser/api/electron_api_web_contents.h"
+#include "shell/browser/api/owned_navigation_history.h"
+#include "shell/browser/browser.h"
+#include "shell/common/gin_converters/file_path_converter.h"
+#include "shell/common/gin_converters/value_converter.h"
+#include "shell/common/gin_helper/dictionary.h"
+#include "shell/common/gin_helper/promise.h"
+
+namespace electron::api {
+namespace {
+using Source = OwnedNavigationHistory;
+using Promise = gin_helper::Promise<base::DictValue>;
+struct Reader {
+  std::shared_ptr<Source> source;
+  std::set<std::string> pending;
+  std::vector<base::WeakPtr<content::WebContents>> observed;
+  bool closed = false;
+};
+using ReaderRef = std::shared_ptr<Reader>;
+class Sources final : public gin::PerIsolateData::DisposeObserver {
+ public:
+  explicit Sources(v8::Isolate* isolate) { gin::PerIsolateData::From(isolate)->AddDisposeObserver(this); }
+  static auto& All() {
+    static base::NoDestructor<std::map<v8::Isolate*, std::unique_ptr<Sources>>> values;
+    return *values;
+  }
+  void OnBeforeDispose(v8::Isolate*) override {}
+  void OnDisposed() override {}
+  void OnBeforeMicrotasksRunnerDispose(v8::Isolate* isolate) override {
+    for (auto& [path, source] : sources) if (auto current = source.lock()) current->Shutdown();
+    sources.clear(); gin::PerIsolateData::From(isolate)->RemoveDisposeObserver(this);
+    All().erase(isolate);
+  }
+  std::map<base::FilePath, std::weak_ptr<Source>> sources;
+};
+bool Hex(const std::string& value, size_t length) {
+  return value.size() == length && value.find_first_not_of("0123456789abcdef") == std::string::npos;
+}
+bool Fields(const base::DictValue& value, std::initializer_list<std::string_view> allowed) {
+  for (const auto [key, item] : value) {
+    if (std::find(allowed.begin(), allowed.end(), key) == allowed.end()) return false;
+  }
+  return true;
+}
+void Close(ReaderRef reader) {
+  if (reader->closed) return;
+  reader->closed = true; auto pending = std::move(reader->pending);
+  for (const auto& id : pending) reader->source->Cancel(id);
+  for (const auto& guest : reader->observed) if (guest) reader->source->Unobserve(guest.get());
+  reader->observed.clear();
+  reader->source.reset();
+}
+bool Observe(ReaderRef reader, WebContents* guest, gin::Arguments* args) {
+  if (reader->closed || !guest || !guest->IsOwnedGuest() || !guest->web_contents()) {
+    args->ThrowError("Navigation history accepts only a current owned guest"); return false;
+  }
+  if (!reader->source->Observe(guest->web_contents())) return false;
+  reader->observed.push_back(guest->web_contents()->GetWeakPtr());
+  return true;
+}
+bool Unobserve(ReaderRef reader, WebContents* guest) {
+  if (reader->closed || !guest || !guest->IsOwnedGuest() || !guest->web_contents()) return false;
+  auto found = std::find_if(reader->observed.begin(), reader->observed.end(),
+      [guest](const auto& value) { return value.get() == guest->web_contents(); });
+  if (found == reader->observed.end()) return false;
+  reader->observed.erase(found);
+  return reader->source->Unobserve(guest->web_contents());
+}
+bool Cancel(ReaderRef reader, const std::string& id) {
+  return !reader->closed && reader->pending.contains(id) && reader->source->Cancel(id);
+}
+v8::Local<v8::Promise> Search(ReaderRef reader, std::string id,
+    base::DictValue query, gin::Arguments* args) {
+  Promise promise(args->isolate()); auto result = promise.GetHandle();
+  const auto* text = query.FindString("text"); const auto maximum = query.FindInt("maxResults");
+  if (reader->closed || !Hex(id, 32) || reader->pending.contains(id) ||
+      !Fields(query, {"text", "maxResults", "startTime", "endTime", "deduplicateByDay", "matchingAlgorithm"}) ||
+      !text || !maximum || *maximum <= 0) {
+    promise.RejectWithErrorMessage("Native history query fields are invalid"); return result;
+  }
+  history::QueryOptions options; options.max_count = *maximum;
+  options.visit_order = history::QueryOptions::RECENT_FIRST;
+  options.policy_for_404_visits = history::VisitQuery404sPolicy::kExclude404s;
+  for (const auto field : {"startTime", "endTime"}) {
+    if (!query.contains(field)) continue;
+    const auto time = query.FindDouble(field);
+    if (!time || !std::isfinite(*time) || std::abs(*time) > 8640000000000000.0) {
+      promise.RejectWithErrorMessage("Native history timestamp is invalid"); return result;
+    }
+    (field == std::string_view("startTime") ? options.begin_time : options.end_time) = base::Time::FromMillisecondsSinceUnixEpoch(*time);
+  }
+  if (query.contains("deduplicateByDay")) {
+    const auto per_day = query.FindBool("deduplicateByDay");
+    if (!per_day) { promise.RejectWithErrorMessage("Native history duplicate policy is invalid"); return result; }
+    options.duplicate_policy = *per_day ? history::QueryOptions::REMOVE_DUPLICATES_PER_DAY : history::QueryOptions::REMOVE_ALL_DUPLICATES;
+  }
+  if (query.contains("matchingAlgorithm")) {
+    const auto* matching = query.FindString("matchingAlgorithm");
+    if (!matching || *matching != "alwaysPrefix") { promise.RejectWithErrorMessage("Native history matching algorithm is invalid"); return result; }
+    options.matching_algorithm = query_parser::MatchingAlgorithm::ALWAYS_PREFIX_SEARCH;
+  }
+  reader->pending.insert(id);
+  reader->source->Search(id, base::UTF8ToUTF16(*text), options,
+      base::BindOnce([](ReaderRef owner, std::string request, Promise value, Source::Result result) {
+        owner->pending.erase(request);
+        if (owner->closed) value.RejectWithErrorMessage("Native history reader is closed");
+        else if (!result.error.empty()) value.RejectWithErrorMessage(result.error);
+        else value.Resolve(result.value);
+      }, reader, id, std::move(promise)));
+  return result;
+}
+v8::Local<v8::Promise> Ready(ReaderRef reader, gin::Arguments* args) {
+  Promise promise(args->isolate()); auto result = promise.GetHandle();
+  if (reader->closed) {
+    promise.RejectWithErrorMessage("Native history reader is closed"); return result;
+  }
+  reader->source->Ready(base::BindOnce([](ReaderRef owner, Promise value, Source::Result ready) {
+    if (owner->closed) value.RejectWithErrorMessage("Native history reader is closed");
+    else if (!ready.error.empty()) value.RejectWithErrorMessage(ready.error);
+    else value.Resolve(ready.value);
+  }, reader, std::move(promise)));
+  return result;
+}
+gin_helper::Dictionary ReaderObject(v8::Isolate* isolate, ReaderRef reader) {
+  auto object = gin_helper::Dictionary::CreateEmpty(isolate);
+  object.SetMethod("ready", base::BindRepeating(&Ready, reader));
+  object.SetMethod("observe", base::BindRepeating(&Observe, reader));
+  object.SetMethod("unobserve", base::BindRepeating(&Unobserve, reader));
+  object.SetMethod("search", base::BindRepeating(&Search, reader));
+  object.SetMethod("cancel", base::BindRepeating(&Cancel, reader));
+  object.SetMethod("close", base::BindRepeating(&Close, reader));
+  return object;
+}
+}
+v8::Local<v8::Value> CreateOwnedNavigationHistory(base::DictValue options, gin::Arguments* args) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const auto* directory = options.FindString("directory"), *id = options.FindString("sourceId"), *digest = options.FindString("sourceRefDigest");
+  if (!BUILDFLAG(ENABLE_OWNED_GUEST_EMBEDDER) || !Browser::Get()->is_ready() ||
+      options.size() != 3 || !directory || !id || !digest || !base::Uuid::ParseLowercase(*id).is_valid() || !Hex(*digest, 64)) {
+    args->ThrowError("Owned navigation history requires admitted source identity and engine readiness");
+    return v8::Undefined(args->isolate());
+  }
+  const auto path = base::FilePath::FromUTF8Unsafe(*directory);
+  base::FilePath canonical;
+  if (!path.IsAbsolute() || !base::DirectoryExists(path) || !base::NormalizeFilePath(path, &canonical) || canonical != path) {
+    args->ThrowError("Owned navigation history directory is not canonical");
+    return v8::Undefined(args->isolate());
+  }
+  auto& owners = Sources::All()[args->isolate()]; if (!owners) owners = std::make_unique<Sources>(args->isolate());
+  auto& weak = owners->sources[path]; auto source = weak.lock();
+  if (source && (source->source_id() != *id || source->source_digest() != *digest)) {
+    args->ThrowError("Owned navigation history source identity changed");
+    return v8::Undefined(args->isolate());
+  }
+  if (!source) { source = std::make_shared<Source>(path, *id, *digest); weak = source; }
+  auto reader = std::make_shared<Reader>(); reader->source = source;
+  return ReaderObject(args->isolate(), std::move(reader)).GetHandle();
+}
+}
