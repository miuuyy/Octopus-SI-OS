+#ifndef ELECTRON_SHELL_BROWSER_API_OWNED_NAVIGATION_HISTORY_H_
+#define ELECTRON_SHELL_BROWSER_API_OWNED_NAVIGATION_HISTORY_H_
+
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "base/values.h"
+#include "components/history/core/browser/history_service_observer.h"
+#include "components/history/core/browser/history_types.h"
+
+namespace content { class WebContents; }
+namespace history { class HistoryService; }
+namespace electron::api {
+class OwnedNavigationHistory final : public history::HistoryServiceObserver {
+ public:
+  struct Result { base::DictValue value; std::string error; };
+  using Reply = base::OnceCallback<void(Result)>;
+  OwnedNavigationHistory(base::FilePath directory, std::string source_id,
+                         std::string source_digest);
+  ~OwnedNavigationHistory() override;
+  void Ready(Reply reply);
+  bool Observe(content::WebContents* contents);
+  bool Unobserve(content::WebContents* contents);
+  void Search(std::string request_id, std::u16string text,
+              history::QueryOptions options, Reply reply);
+  bool Cancel(const std::string& request_id);
+  void Shutdown();
+  const std::string& source_id() const { return source_id_; }
+  const std::string& source_digest() const { return source_digest_; }
+  const std::string& epoch() const { return epoch_; }
+  base::DictValue Identity() const;
+  void DatabaseError();
+
+ private:
+  class Observer;
+  friend class Observer;
+  struct Pending { std::unique_ptr<base::CancelableTaskTracker> tracker; Reply reply; };
+  void OnHistoryServiceLoaded(history::HistoryService* service) override;
+  void HistoryServiceBeingDeleted(history::HistoryService* service) override;
+  void CompleteReady(const std::string& error);
+  void CompleteQuery(std::string request_id, history::QueryResults results);
+  bool Available() const;
+  std::unique_ptr<history::HistoryService> service_;
+  std::set<Observer*> observers_;
+  std::vector<Reply> ready_;
+  std::map<std::string, Pending> pending_;
+  std::string source_id_, source_digest_, epoch_;
+  bool loaded_ = false;
+  bool stopped_ = false;
+  std::string error_;
+  base::WeakPtrFactory<OwnedNavigationHistory> weak_factory_{this};
+};
+}
+#endif
