+#include "components/history/core/browser/history_client.h"
+#include "components/history/core/browser/history_constants.h"
+#include "components/history/core/browser/history_database_params.h"
+#include "components/history/core/browser/history_service.h"
+#include "components/history/core/browser/url_row.h"
+#include "components/version_info/channel.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "net/http/http_response_headers.h"
+#include "ui/base/page_transition_types.h"
+
+namespace electron::api {
+namespace {
+bool CanRecord(const GURL& url) { return url.is_valid() && url.SchemeIsHTTPOrHTTPS(); }
+class BackendClient final : public history::HistoryBackendClient {
+ public:
+  bool IsPinnedURL(const GURL&) override { return false; }
+  std::vector<history::URLAndTitle> GetPinnedURLs() override { return {}; }
+  bool IsWebSafe(const GURL& url) override { return CanRecord(url); }
+};
+class Client final : public history::HistoryClient {
+ public:
+  explicit Client(OwnedNavigationHistory* owner) : owner_(owner) {}
+  void OnHistoryServiceCreated(history::HistoryService* service) override {
+    CHECK(owner_); CHECK(service);
+  }
+  void Shutdown() override { owner_ = nullptr; }
+  history::CanAddURLCallback GetThreadSafeCanAddURLCallback() const override {
+    return base::BindRepeating(&CanRecord);
+  }
+  void NotifyProfileError(sql::InitStatus, const std::string&) override {
+    if (owner_) owner_->DatabaseError();
+  }
+  std::unique_ptr<history::HistoryBackendClient> CreateBackendClient() override {
+    return std::make_unique<BackendClient>();
+  }
+  void UpdateBookmarkLastUsedTime(int64_t, base::Time) override { NOTREACHED(); }
+ private:
+  raw_ptr<OwnedNavigationHistory> owner_;
+};
+}
+
+class OwnedNavigationHistory::Observer final
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<Observer> {
+ public:
+  bool Attach(base::WeakPtr<OwnedNavigationHistory> owner) {
+    if (!owner || !owner->Available() || owner_ || !web_contents()) return false;
+    owner_ = owner; owner_->observers_.insert(this); return true;
+  }
+  bool AttachedTo(const OwnedNavigationHistory* owner) const {
+    return owner_.get() == owner;
+  }
+  void Detach() {
+    if (owner_) {
+      EndVisit();
+      if (owner_->Available() && web_contents()) owner_->service_->ClearCachedDataForContextID(history::ContextIDForWebContents(web_contents()));
+      owner_->observers_.erase(this); owner_.reset();
+    }
+    cached_.reset();
+  }
+  ~Observer() override { Detach(); }
+
+ private:
+  friend class content::WebContentsUserData<Observer>;
+  explicit Observer(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<Observer>(*contents) {}
+  void EndVisit() {
+    if (owner_ && owner_->Available() && cached_) {
+      owner_->service_->UpdateWithPageEndTime(
+          history::ContextIDForWebContents(web_contents()), cached_->entry,
+          cached_->url, base::Time::Now());
+    }
+  }
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (!owner_ || !owner_->Available() || !handle->HasCommitted()) return;
+    if (handle->IsInPrimaryMainFrame()) { loading_ = true; title_changes_ = 0; }
+    else if (!handle->IsInMainFrame() && !handle->HasSubframeNavigationEntryCommitted()) return;
+    if (!handle->ShouldUpdateHistory() ||
+        !handle->GetRenderFrameHost()->GetPage().IsPrimary() || !CanRecord(handle->GetURL())) return;
+    auto* entry = web_contents()->GetController().GetLastCommittedEntry();
+    if (!entry || entry->GetTimestamp().is_null()) return;
+    const int response = handle->GetResponseHeaders() ? handle->GetResponseHeaders()->response_code() : 0;
+    const auto transition = handle->GetPageTransition();
+    GURL referrer = handle->GetReferrer().url;
+    if (handle->IsInPrimaryMainFrame() && !referrer.is_empty() &&
+        referrer == referrer.DeprecatedGetOriginAsURL() &&
+        referrer.DeprecatedGetOriginAsURL() == handle->GetPreviousPrimaryMainFrameURL().DeprecatedGetOriginAsURL()) {
+      referrer = handle->GetPreviousPrimaryMainFrameURL();
+    }
+    const bool hidden = !ui::PageTransitionIsMainFrame(transition) || (response >= 400 && response < 600);
+    history::HistoryAddPageArgs args(
+        handle->GetURL(), entry->GetTimestamp(),
+        history::ContextIDForWebContents(web_contents()), entry->GetUniqueID(),
+        handle->GetNavigationId(), referrer, handle->GetRedirectChain(), transition,
+        hidden, history::SOURCE_BROWSED,
+        response == 404 ? history::VisitResponseCodeCategory::k404 : history::VisitResponseCodeCategory::kNot404,
+        handle->DidReplaceEntry(), false,
+        history::VisitContextEphemerality::kNotEphemeral,
+        handle->IsSameDocument() || handle->GetReloadType() != content::ReloadType::NONE
+            ? std::optional<std::u16string>(web_contents()->GetTitle()) : std::nullopt);
+    const auto virtual_url = web_contents()->GetLastCommittedURL();
+    if (ui::PageTransitionIsMainFrame(transition) && virtual_url != args.url && CanRecord(virtual_url)) {
+      args.url = virtual_url;
+      if (!args.redirects.empty()) args.redirects.back() = virtual_url;
+    }
+    EndVisit(); cached_ = Navigation{args.nav_entry_id, args.url};
+    owner_->service_->AddPage(std::move(args));
+  }
+  void DidFinishLoad(content::RenderFrameHost* frame, const GURL&) override {
+    if (!frame->IsInPrimaryMainFrame()) return;
+    loading_ = false; load_completed_ = base::TimeTicks::Now();
+  }
+  void TitleWasSet(content::NavigationEntry* entry) override {
+    if (!owner_ || !owner_->Available() || !entry || !cached_ ||
+        title_changes_ >= history::kMaxTitleChanges || !CanRecord(entry->GetVirtualURL())) return;
+    if (loading_ || base::TimeTicks::Now() - load_completed_ < history::GetTitleSettingWindow()) {
+      owner_->service_->SetPageTitle(entry->GetVirtualURL(), entry->GetTitleForDisplay());
+      ++title_changes_;
+    }
+  }
+  void WebContentsDestroyed() override { Detach(); }
+  struct Navigation { int entry; GURL url; };
+  std::optional<Navigation> cached_;
+  base::WeakPtr<OwnedNavigationHistory> owner_;
+  bool loading_ = false;
+  int title_changes_ = 0;
+  base::TimeTicks load_completed_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(OwnedNavigationHistory::Observer);
+
+OwnedNavigationHistory::OwnedNavigationHistory(base::FilePath directory,
+    std::string source_id, std::string source_digest)
+    : source_id_(std::move(source_id)), source_digest_(std::move(source_digest)),
+      epoch_(base::Uuid::GenerateRandomV4().AsLowercaseString()) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  service_ = std::make_unique<history::HistoryService>(std::make_unique<Client>(this), nullptr, nullptr, nullptr);
+  service_->AddObserver(this);
+  if (!service_->Init(history::HistoryDatabaseParams(directory, history::ToHistoryDownloadInterruptReason(download::DOWNLOAD_INTERRUPT_REASON_NONE), history::ToHistoryDownloadInterruptReason(download::DOWNLOAD_INTERRUPT_REASON_CRASH), version_info::Channel::STABLE))) DatabaseError();
+}
+OwnedNavigationHistory::~OwnedNavigationHistory() { Shutdown(); }
+bool OwnedNavigationHistory::Available() const { return !stopped_ && error_.empty() && loaded_ && service_; }
+base::DictValue OwnedNavigationHistory::Identity() const {
+  base::DictValue value;
+  value.Set("sourceId", source_id_); value.Set("sourceRefDigest", source_digest_);
+  value.Set("epoch", epoch_); value.Set("ready", Available());
+  value.Set("bookmarks", false); value.Set("visitedLinks", false);
+  return value;
+}
+void OwnedNavigationHistory::Ready(Reply reply) {
+  if (stopped_ || !error_.empty()) { std::move(reply).Run({{}, error_.empty() ? "Native navigation history is closed" : error_}); return; }
+  if (Available()) { std::move(reply).Run({Identity(), {}}); return; }
+  ready_.push_back(std::move(reply));
+}
+void OwnedNavigationHistory::CompleteReady(const std::string& error) {
+  auto pending = std::move(ready_);
+  for (auto& reply : pending) std::move(reply).Run({error.empty() ? Identity() : base::DictValue(), error});
+}
+void OwnedNavigationHistory::OnHistoryServiceLoaded(history::HistoryService* service) {
+  if (service != service_.get() || stopped_ || !error_.empty()) return;
+  loaded_ = true; CompleteReady({});
+}
+void OwnedNavigationHistory::HistoryServiceBeingDeleted(history::HistoryService* service) {
+  if (service == service_.get() && !stopped_) DatabaseError();
+}
+void OwnedNavigationHistory::DatabaseError() {
+  error_ = "Native navigation history database is unavailable";
+  CompleteReady(error_);
+  auto pending = std::move(pending_);
+  for (auto& [id, item] : pending) { item.tracker->TryCancelAll(); std::move(item.reply).Run({{}, error_}); }
+}
+bool OwnedNavigationHistory::Observe(content::WebContents* contents) {
+  if (!Available() || !contents || contents->IsBeingDestroyed()) return false;
+  Observer::CreateForWebContents(contents);
+  return Observer::FromWebContents(contents)->Attach(weak_factory_.GetWeakPtr());
+}
+bool OwnedNavigationHistory::Unobserve(content::WebContents* contents) {
+  auto* observer = contents ? Observer::FromWebContents(contents) : nullptr;
+  if (!observer || !observer->AttachedTo(this)) return false;
+  observer->Detach(); return true;
+}
+void OwnedNavigationHistory::Search(std::string request_id, std::u16string text,
+    history::QueryOptions options, Reply reply) {
+  if (!Available() || request_id.empty() || pending_.contains(request_id)) {
+    std::move(reply).Run({{}, "Native navigation history query is unavailable or duplicated"}); return;
+  }
+  auto [item, inserted] = pending_.emplace(request_id, Pending{std::make_unique<base::CancelableTaskTracker>(), std::move(reply)});
+  CHECK(inserted);
+  service_->QueryHistory(text, options,
+      base::BindOnce(&OwnedNavigationHistory::CompleteQuery, weak_factory_.GetWeakPtr(), request_id), item->second.tracker.get());
+}
+void OwnedNavigationHistory::CompleteQuery(std::string request_id, history::QueryResults results) {
+  auto found = pending_.find(request_id); if (found == pending_.end()) return;
+  auto reply = std::move(found->second.reply); pending_.erase(found);
+  if (!Available()) { std::move(reply).Run({{}, "Native navigation history became unavailable"}); return; }
+  base::ListValue rows;
+  for (const auto& row : results) {
+    base::DictValue item; item.Set("url", row.url().spec());
+    item.Set("title", base::UTF16ToUTF8(row.title()));
+    item.Set("lastVisitTime", row.visit_time().InMillisecondsFSinceUnixEpoch());
+    rows.Append(std::move(item));
+  }
+  auto value = Identity(); value.Set("items", std::move(rows)); value.Set("requestId", request_id);
+  std::move(reply).Run({std::move(value), {}});
+}
+bool OwnedNavigationHistory::Cancel(const std::string& request_id) {
+  auto found = pending_.find(request_id); if (found == pending_.end()) return false;
+  auto pending = std::move(found->second); pending_.erase(found); pending.tracker->TryCancelAll();
+  std::move(pending.reply).Run({{}, "Native navigation history query was cancelled"}); return true;
+}
+void OwnedNavigationHistory::Shutdown() {
+  if (stopped_) return;
+  while (!observers_.empty()) (*observers_.begin())->Detach();
+  stopped_ = true; weak_factory_.InvalidateWeakPtrs(); CompleteReady("Native navigation history is closed");
+  auto pending = std::move(pending_);
+  for (auto& [id, item] : pending) { item.tracker->TryCancelAll(); std::move(item.reply).Run({{}, "Native navigation history is closed"}); }
+  if (service_) { service_->RemoveObserver(this); service_->Shutdown(); service_.reset(); }
+}
+}
