{
  "id": "coder.exec",
  "interface": "system_coder_env",
  "handler_config": {
    "operation": "start_command",
    "default_timeout_ms": 120000,
    "max_timeout_ms": 600000,
    "default_yield_time_ms": 10000,
    "max_yield_time_ms": 30000,
    "default_max_output_bytes": 65536,
    "max_output_bytes": 1048576,
    "max_buffered_output_bytes": 4194304,
    "max_buffered_output_events": 4096,
    "max_processes_per_worker_environment": 16,
    "max_input_bytes": 65536,
    "cleanup_timeout_ms": 10000,
    "default_shell": "sh",
    "allowed_shells": ["sh", "bash", "zsh"],
    "allow_login_shell": true
  },
  "process": {
    "bin": "target/debug/octopus-coder-exec-tool",
    "interrupted_effect_recovery": "reinvoke_exact_artifact",
    "inherit_env": ["HOME", "PATH"],
    "authority": {
      "read_root_slots": ["registry_worker_environment_kind_root", "repo_root"],
      "write_root_slots": ["git_common_root", "worktree_root"],
      "executable_root_slots": ["worktree_root"],
      "optional_read_root_slots": ["platform_toolchain_root", "tool_cache_root", "toolchain_root"],
      "optional_write_root_slots": ["platform_toolchain_root"],
      "optional_executable_root_slots": ["platform_toolchain_root", "tool_cache_root", "toolchain_root"],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": ["git", "sh", "bash"],
      "optional_executable_commands": ["zsh"],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": ["PATH"],
      "allow_network": true,
      "allow_local_ipc": true,
      "allow_sandbox_delegation": true
    }
  },
  "supported_worker_environment_kinds": [
    "git_worktree"
  ],
  "description": "Start one bounded persistent command in the invoking run's sandboxed leased worktree. Output is collected as one ordered stdout/stderr/PTY event sequence and returned in exact tagged UTF-8 or base64 chunks. Use coder.write_stdin with the opaque process_id while continuation_available is true.",
  "args_schema": {
    "type": "object",
    "properties": {
      "command": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "description": "Exact argv array, or a script string executed by the descriptor-selected shell."
      },
      "shell": {
        "type": "string",
        "enum": ["sh", "bash", "zsh"],
        "description": "Shell for a command string. Defaults to sh."
      },
      "login": {
        "type": "boolean",
        "description": "Use login-shell semantics for a command string. Defaults to true."
      },
      "workdir": {
        "type": "string",
        "description": "Working directory relative to the leased worktree. Defaults to the worktree root."
      },
      "tty": {
        "type": "boolean",
        "description": "Allocate a PTY when true. Defaults to false."
      },
      "yield_time_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 30000,
        "description": "Wait window for collecting the ordered output sequence. Defaults to 10000."
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000,
        "description": "Whole-process deadline in milliseconds. Defaults to 120000."
      },
      "max_output_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1048576,
        "description": "Maximum exact output bytes returned by this call. Defaults to 65536; unread ordered bytes remain attached to the process for coder.write_stdin."
      }
    },
    "required": [
      "command"
    ],
    "additionalProperties": false
  },
  "is_world_effect": false
}
