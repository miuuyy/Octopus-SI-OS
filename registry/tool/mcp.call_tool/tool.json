{
  "id": "mcp.call_tool",
  "interface": "system_mcp",
  "process": {
    "bin": "target/debug/octopus-mcp-stdio-room-tool",
    "coordinate_root_slots": ["interface_life_install_root"],
    "inherit_env": [
      "PATH"
    ],
    "inherit_env_from_interface": [
      "/interface_driver_config/private_config/process_env_keys"
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [
        "PATH"
      ],
      "allow_network": true,
      "allow_local_ipc": false
    }
  },
  "handler_config": { "operation": "call_tool" },
  "supported_worker_environment_kinds": [
    "mcp_stdio_session"
  ],
  "description": "Call one tool exposed by the persistent MCP server in this worker environment.",
  "args_schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "arguments": {
        "type": "object"
      },
      "progress_token": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "number" }
        ]
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "is_world_effect": true
}
