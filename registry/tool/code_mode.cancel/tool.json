{
  "id": "code_mode.cancel",
  "interface": "system_code_mode",
  "handler_config": {
    "operation": "cancel"
  },
  "process": {
    "bin": "target/debug/octopus-code-mode-room-tool",
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": false,
      "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": [
    "code_mode"
  ],
  "description": "Terminate one V8 cell and reject any unresolved nested-tool waits. Returns every frontier the cell still retains; a cell that already completed returns its output and error.",
  "args_schema": {
    "type": "object",
    "properties": {
      "cell_id": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "cell_id"
    ],
    "additionalProperties": false
  },
  "is_world_effect": false
}
