{
  "id": "memory.read",
  "interface": "system_memory",
  "process": {
    "bin": "target/debug/octopus-artifact-bound-tool",
    "interrupted_effect_recovery": "reinvoke_exact_artifact",
    "authority": {
      "read_root_slots": ["ee_instances_root", "registry_artifact_root"],
      "write_root_slots": ["registry_artifact_root"],
      "executable_root_slots": [],
      "read_paths": [], "write_paths": [], "executable_paths": [],
      "executable_commands": [], "read_env_paths": [], "write_env_paths": [],
      "executable_env_paths": [], "allow_network": false, "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": ["system_room"],
  "handler_config": { "operation": "memory_read" },
  "description": "Read one remembered note in full by its id, with when it was saved, its scope and how often it has been used. Reading records that the note was used today; consolidation keeps used notes and lets unused ones go. Pass revision to make sure the note has not changed since you found it.",
  "args_schema": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 512 },
      "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "is_world_effect": false
}
