{
  "id": "workspace.build",
  "interface": "system_workspace_env",
  "handler_config": {
    "operation": "run_command",
    "default_timeout_ms": 600000,
    "max_timeout_ms": 1800000,
    "default_max_output_bytes": 131072,
    "max_output_bytes": 1048576,
    "default_shell": "sh",
    "allowed_shells": ["sh", "bash", "zsh"],
    "allow_login_shell": true
  },
  "process": {
    "bin": "target/debug/octopus-workspace-exec-tool",
    "inherit_env": ["HOME", "PATH"],
    "authority": {
      "read_root_slots": ["registry_worker_environment_kind_root", "workspace_root"],
      "write_root_slots": ["workspace_root"], "executable_root_slots": ["workspace_root"],
      "optional_read_root_slots": ["host_filesystem_root", "platform_toolchain_root", "tool_cache_root", "toolchain_root"],
      "optional_write_root_slots": ["host_filesystem_root", "platform_toolchain_root"],
      "optional_executable_root_slots": ["host_filesystem_root", "platform_toolchain_root", "tool_cache_root", "toolchain_root"],
      "read_paths": [], "write_paths": [], "executable_paths": [],
      "executable_commands": ["git", "sh", "bash", "zsh"],
      "read_env_paths": [], "write_env_paths": [], "executable_env_paths": ["PATH"],
      "allow_network": true, "allow_local_ipc": true, "allow_sandbox_delegation": true, "allow_process_signals": true
    }
  },
  "supported_worker_environment_kinds": ["filesystem_workspace"],
  "description": "Run one bounded build or verification command from the direct workspace or an additional filesystem root explicitly granted to this task and return exact UTF-8/base64 output plus head-tail omission evidence.",
  "args_schema": {
    "type": "object",
    "properties": {
      "command": {
        "oneOf": [
          {"type": "array", "items": {"type": "string"}, "minItems": 1},
          {"type": "string", "minLength": 1}
        ]
      },
      "shell": {"type": "string", "enum": ["sh", "bash", "zsh"]},
      "login": {"type": "boolean"},
      "workdir": {"type": "string"},
      "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 1800000, "description": "Execution deadline. Defaults to 600000 ms, at most 1800000 ms; the call returns when the command exits or the deadline stops it."},
      "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
    },
    "required": ["command"],
    "additionalProperties": false
  },
  "is_world_effect": false
}
