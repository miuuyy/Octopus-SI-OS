{
  "id": "memory.search",
  "interface": "system_memory",
  "process": {
    "bin": "target/debug/octopus-artifact-bound-tool",
    "interrupted_effect_recovery": "reinvoke_exact_artifact",
    "authority": {
      "read_root_slots": ["ee_instances_root", "registry_artifact_root"],
      "write_root_slots": [], "executable_root_slots": [],
      "read_paths": [], "write_paths": [], "executable_paths": [],
      "executable_commands": [], "read_env_paths": [], "write_env_paths": [],
      "executable_env_paths": [], "allow_network": false, "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": ["system_room"],
  "handler_config": { "operation": "memory_search" },
  "description": "Search remembered notes visible to this run: those of its environment and of the environments above it. Pass a few concrete keywords from the task; matches are ranked by keyword hits, newest first on ties, with a preview and the id to open with memory.read. No match only means these words were not found. If supplied, max_results must be an integer from 1 to 20.",
  "args_schema": {
    "type": "object",
    "properties": {
      "query": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "max_results": { "type": "integer", "minimum": 1, "maximum": 20 }
    },
    "required": ["query"],
    "additionalProperties": false
  },
  "is_world_effect": false
}
