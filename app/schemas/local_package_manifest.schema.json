{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octopus.local/schemas/local_package_manifest.schema.json",
  "title": "Octopus Local Package Manifest",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "id",
    "version",
    "product_kind",
    "product_id",
    "release_status",
    "display",
    "members"
  ],
  "properties": {
    "schema": {
      "const": "octopus.local_package"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "product_kind": {
      "enum": [
        "application",
        "driver",
        "artifact"
      ]
    },
    "product_id": {
      "$ref": "#/$defs/id"
    },
    "release_status": {
      "enum": [
        "system",
        "optional"
      ]
    },
    "display": {
      "type": "object",
      "required": [
        "name",
        "description",
        "developer",
        "category"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 480
        },
        "developer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "category": {
          "$ref": "#/$defs/id"
        },
        "icon": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "required_packages": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "registry_kind",
          "owner"
        ],
        "properties": {
          "registry_kind": {
            "enum": [
              "interface",
              "worker_environment_kind",
              "tool",
              "artifact",
              "mark",
              "verifier",
              "ee_template"
            ]
          },
          "owner": {
            "$ref": "#/$defs/id"
          },
          "primary": {
            "type": "boolean"
          },
          "application_host": {
            "const": true
          },
          "data_directories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "configuration": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/configurationEntry"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "configurationEntry": {
      "type": "object",
      "required": [
        "path",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "pointer",
              "schema"
            ],
            "additionalProperties": false,
            "properties": {
              "pointer": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024
              },
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$",
      "maxLength": 64
    }
  }
}
