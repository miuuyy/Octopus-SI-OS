{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octopus.local/schemas/local_application_pack.schema.json",
  "title": "Octopus Local Application Pack",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "id",
    "version",
    "name",
    "description",
    "components"
  ],
  "properties": {
    "schema": { "const": "octopus.local_application_pack" },
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$",
      "maxLength": 64
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 96 },
    "description": { "type": "string", "minLength": 1, "maxLength": 480 },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["package_id", "selection", "reason"],
        "properties": {
          "package_id": { "$ref": "#/$defs/id" },
          "selection": { "enum": ["included", "recommended"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["extension_id", "selection", "reason"],
        "properties": {
          "extension_id": { "$ref": "#/$defs/id" },
          "selection": { "const": "recommended" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "additionalProperties": false
      }
    },
    "workspace_setup": {
      "type": "object",
      "required": ["selection", "home", "task", "project_defaults"],
      "properties": {
        "selection": { "enum": ["included", "recommended"] },
        "home": {
          "type": "object",
          "required": [
            "provider_interface_id",
            "worker_interface_id",
            "context_artifact_bindings",
            "selected_worker_environment_kinds"
          ],
          "properties": {
            "provider_interface_id": { "$ref": "#/$defs/id" },
            "worker_interface_id": { "$ref": "#/$defs/id" },
            "door_host_slots": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/id" },
              "additionalProperties": {
                "type": "object",
                "propertyNames": { "$ref": "#/$defs/id" },
                "additionalProperties": { "type": "string", "pattern": "^/[^\\u0000]*$" }
              }
            },
            "context_artifact_bindings": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" }
                },
                "additionalProperties": false
              }
            },
            "selected_worker_environment_kinds": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          },
          "additionalProperties": false
        },
        "task": {
          "type": "object",
          "required": ["worker_interface_id", "context_artifact_bindings", "selected_worker_environment_kinds"],
          "properties": {
            "worker_interface_id": { "$ref": "#/$defs/id" },
            "context_artifact_bindings": { "$ref": "#/properties/workspace_setup/properties/home/properties/context_artifact_bindings" },
            "selected_worker_environment_kinds": { "$ref": "#/properties/workspace_setup/properties/home/properties/selected_worker_environment_kinds" }
          },
          "additionalProperties": false
        },
        "agent_presets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "id",
              "component_package_id",
              "name",
              "icon",
              "worker_interface_id",
              "provider_interface_id",
              "context_artifact_bindings",
              "selected_worker_environment_kinds",
              "selected_application_ids"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "component_package_id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "icon": {
                "enum": [
                  "default",
                  "strict",
                  "calm",
                  "curious",
                  "glasses",
                  "goggles",
                  "visor",
                  "eyepiece",
                  "headphones",
                  "headset",
                  "headband",
                  "hardhat"
                ]
              },
              "worker_interface_id": {
                "$ref": "#/$defs/id"
              },
              "provider_interface_id": {
                "$ref": "#/$defs/id"
              },
              "context_artifact_bindings": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "selected_worker_environment_kinds": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "selected_application_ids": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "project_defaults": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["package_id", "default_for_new_tasks"],
            "properties": {
              "package_id": { "$ref": "#/$defs/id" },
              "default_for_new_tasks": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "triggers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["package_id", "template_interface_id", "interface_id", "quiet_period_seconds", "task"],
            "properties": {
              "package_id": { "$ref": "#/$defs/id" },
              "template_interface_id": { "$ref": "#/$defs/id" },
              "interface_id": { "$ref": "#/$defs/id" },
              "quiet_period_seconds": { "type": "integer", "minimum": 60, "maximum": 31536000 },
              "task": {
                "type": "object",
                "required": ["worker_interface_id", "context_artifact_bindings", "selected_worker_environment_kinds"],
                "properties": {
                  "worker_interface_id": { "$ref": "#/$defs/id" },
                  "context_artifact_bindings": { "$ref": "#/properties/workspace_setup/properties/home/properties/context_artifact_bindings" },
                  "selected_worker_environment_kinds": { "$ref": "#/properties/workspace_setup/properties/home/properties/selected_worker_environment_kinds" },
                  "door_host_slots": { "$ref": "#/properties/workspace_setup/properties/home/properties/door_host_slots" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
