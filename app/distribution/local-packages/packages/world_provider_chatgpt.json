{
  "schema": "octopus.local_package",
  "schema_version": 1,
  "id": "world_provider_chatgpt",
  "version": "1.1.0",
  "product_kind": "application",
  "product_id": "world_provider_chatgpt",
  "release_status": "optional",
  "display": {
    "name": "ChatGPT",
    "description": "Sign in with your ChatGPT account and use its models through the declared Octopus provider.",
    "developer": "OpenAI",
    "category": "provider",
    "icon": "sparkles"
  },
  "members": [
    {
      "registry_kind": "interface",
      "owner": "world_provider_chatgpt",
      "primary": true,
      "configuration": [
        {
          "path": "interface.json",
          "fields": [
            {
              "pointer": "/interface_driver_config/private_config/model",
              "schema": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "pointer": "/interface_driver_config/private_config/reasoning_effort",
              "schema": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max",
                  "ultra"
                ]
              }
            },
            {
              "pointer": "/interface_driver_config/private_config/native_thread_sandbox",
              "schema": {
                "type": "string",
                "enum": [
                  "read-only",
                  "workspace-write",
                  "danger-full-access"
                ]
              }
            }
          ]
        },
        {
          "path": "life.json",
          "fields": [
            {
              "pointer": "/processes/0/authority/sandbox_mode",
              "schema": {
                "type": "string",
                "enum": [
                  "enforced",
                  "disabled"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "required_packages": [
    "world_provider_codex"
  ]
}
