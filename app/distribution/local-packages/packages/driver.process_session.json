{
  "schema": "octopus.local_package",
  "schema_version": 1,
  "id": "driver.process_session",
  "version": "1.0.2",
  "product_kind": "driver",
  "product_id": "process_session",
  "release_status": "optional",
  "display": {
    "name": "Process Session",
    "description": "Private process rooms with their own workspace, terminals and long-running commands.",
    "developer": "Octopus",
    "category": "worker_environment",
    "icon": "terminal"
  },
  "members": [
    {
      "registry_kind": "worker_environment_kind",
      "owner": "process_session",
      "primary": true
    },
    {
      "registry_kind": "tool",
      "owner": "exec.file_read",
      "configuration": [{"path":"tool.json","fields":[{"pointer":"/process/authority/sandbox_mode","schema":{"type":"string","enum":["enforced","disabled"]}}]}]
    },
    {
      "registry_kind": "tool",
      "owner": "exec.file_write",
      "configuration": [{"path":"tool.json","fields":[{"pointer":"/process/authority/sandbox_mode","schema":{"type":"string","enum":["enforced","disabled"]}}]}]
    },
    {
      "registry_kind": "tool",
      "owner": "exec.run",
      "configuration": [{"path":"tool.json","fields":[{"pointer":"/process/authority/sandbox_mode","schema":{"type":"string","enum":["enforced","disabled"]}}]}]
    },
    {
      "registry_kind": "tool",
      "owner": "process.list",
      "configuration": [{"path":"tool.json","fields":[{"pointer":"/process/authority/sandbox_mode","schema":{"type":"string","enum":["enforced","disabled"]}}]}]
    },
    {
      "registry_kind": "tool",
      "owner": "process.read",
      "configuration": [{"path":"tool.json","fields":[{"pointer":"/process/authority/sandbox_mode","schema":{"type":"string","enum":["enforced","disabled"]}}]}]
    },
    {
      "registry_kind": "tool",
      "owner": "process.signal",
      "configuration": [{"path":"tool.json","fields":[{"pointer":"/process/authority/sandbox_mode","schema":{"type":"string","enum":["enforced","disabled"]}}]}]
    },
    {
      "registry_kind": "tool",
      "owner": "process.start",
      "configuration": [{"path":"tool.json","fields":[{"pointer":"/process/authority/sandbox_mode","schema":{"type":"string","enum":["enforced","disabled"]}}]}]
    },
    {
      "registry_kind": "tool",
      "owner": "process.terminate",
      "configuration": [{"path":"tool.json","fields":[{"pointer":"/process/authority/sandbox_mode","schema":{"type":"string","enum":["enforced","disabled"]}}]}]
    },
    {
      "registry_kind": "tool",
      "owner": "process.write",
      "configuration": [{"path":"tool.json","fields":[{"pointer":"/process/authority/sandbox_mode","schema":{"type":"string","enum":["enforced","disabled"]}}]}]
    },
    {
      "registry_kind": "interface",
      "owner": "system_exec_env",
      "configuration": [{"path":"life.json","fields":[{"pointer":"/processes/0/authority/sandbox_mode","schema":{"type":"string","enum":["enforced","disabled"]}}]}]
    }
  ]
}
