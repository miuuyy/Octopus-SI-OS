{
  "schema": "octopus.local_application_pack",
  "schema_version": 1,
  "id": "codex",
  "version": "1.5.0",
  "name": "Codex Pack",
  "description": "Codex provider, agent working context, and local environments for browser, desktop, files, terminal, and git worktrees.",
  "components": [
    {
      "package_id": "world_cron",
      "selection": "recommended",
      "reason": "Provides time and inactivity triggers for ordinary runs."
    },
    {
      "package_id": "world_system_review",
      "selection": "recommended",
      "reason": "Offers a trigger that reviews recent work after a quiet period and improves Octopus when the evidence supports it."
    },
    {
      "package_id": "world_memory_cron",
      "selection": "recommended",
      "reason": "Offers a trigger that consolidates Home memory after a quiet period: duplicates merged, contradictions settled, stale notes folded."
    },
    {
      "package_id": "world_provider_chatgpt",
      "selection": "recommended",
      "reason": "Keeps the separate ChatGPT provider available for explicit installation."
    },
    {
      "package_id": "world_provider_codex",
      "selection": "included",
      "reason": "Provides the model interface with task-private state and the machine-wide Codex sign-in boundary."
    },
    {
      "package_id": "artifact.codex_context",
      "selection": "included",
      "reason": "Gives tasks the declared architecture and working-role context."
    },
    {
      "package_id": "world_operator_chat",
      "selection": "included",
      "reason": "Provides the exact Home, task, and authoring interfaces without making the provider a runtime identity."
    },
    {
      "package_id": "driver.system_room",
      "selection": "included",
      "reason": "Provides the narrowly granted file authoring room used to create Home and projected task checkpoints."
    },
    {
      "package_id": "system_memory",
      "selection": "included",
      "reason": "Lets Home and tasks remember and find preferences, corrections and proven procedures with one call each."
    },
    {
      "package_id": "driver.browser_session",
      "selection": "included",
      "reason": "Provides the native browser room and its tools for Home and new tasks under their formed policy."
    },
    {
      "package_id": "driver.filesystem_workspace",
      "selection": "included",
      "reason": "Provides the direct project workspace for files, networked commands, PTY sessions, and persistent process control."
    },
    {
      "package_id": "driver.process_session",
      "selection": "included",
      "reason": "Keeps isolated private process rooms available for explicit selection without adding them to ordinary coding tasks."
    },
    {
      "package_id": "driver.git_worktree",
      "selection": "included",
      "reason": "Provides isolated code and file operations in selected project folders."
    },
    {
      "package_id": "driver.desktop_session",
      "selection": "included",
      "reason": "Provides Computer Use tools for Home and new tasks under their formed policy."
    },
    {
      "package_id": "driver.audio_device_session",
      "selection": "included",
      "reason": "Supplies the declared audio dependencies of the Computer Use worker ceiling; tasks select desktop tools separately."
    },
    {
      "package_id": "driver.code_mode",
      "selection": "included",
      "reason": "Provides the declared JavaScript room and artifact-bound persistent context for explicitly selected tasks."
    },
    {
      "package_id": "world_provider_realtime",
      "selection": "included",
      "reason": "Provides Home voice media with explicit control, transcript, delegation and result artifacts."
    }
  ],
  "extensions": [
    {
      "extension_id": "builtin.provider-credential-repair",
      "selection": "recommended",
      "reason": "Offers an explicit machine sign-in check after a provider authentication failure."
    }
  ],
  "workspace_setup": {
    "selection": "included",
    "home": {
      "provider_interface_id": "world_provider_codex",
      "worker_interface_id": "system_worker_operator_home",
      "door_host_slots": {
        "system_workspace_env": {
          "workspace_root": "/",
          "host_filesystem_root": "/"
        }
      },
      "context_artifact_bindings": [
        {
          "id": "artifact-worker-role-template"
        },
        {
          "id": "artifact-grounding-system-architecture"
        },
        {
          "id": "artifact-codebase-layout"
        },
        {
          "id": "artifact-code-mode-browser-prelude"
        },
        {
          "id": "artifact-code-mode-cua-prelude"
        },
        {
          "id": "artifact-worker-role-operator-home"
        },
        {
          "id": "artifact-home-task-authoring"
        },
        {
          "id": "artifact-spawn-literacy"
        },
        {
          "id": "artifact-home-widget-authoring"
        }
      ],
      "selected_worker_environment_kinds": [
        "browser_session",
        "code_mode",
        "desktop_session",
        "filesystem_workspace",
        "system_room"
      ]
    },
    "task": {
      "worker_interface_id": "system_worker_operator_task",
      "context_artifact_bindings": [
        {
          "id": "artifact-worker-role-template"
        },
        {
          "id": "artifact-grounding-system-architecture"
        },
        {
          "id": "artifact-codebase-layout"
        },
        {
          "id": "artifact-code-mode-browser-prelude"
        },
        {
          "id": "artifact-code-mode-cua-prelude"
        },
        {
          "id": "artifact-worker-role-operator-task"
        },
        {
          "id": "artifact-home-task-authoring"
        },
        {
          "id": "artifact-spawn-literacy"
        },
        {
          "id": "artifact-home-widget-authoring"
        }
      ],
      "selected_worker_environment_kinds": [
        "browser_session",
        "code_mode",
        "desktop_session",
        "system_room"
      ]
    },
    "project_defaults": [
      {
        "package_id": "world_provider_codex",
        "default_for_new_tasks": true
      },
      {
        "package_id": "driver.browser_session",
        "default_for_new_tasks": true
      },
      {
        "package_id": "driver.desktop_session",
        "default_for_new_tasks": true
      },
      {
        "package_id": "driver.filesystem_workspace",
        "default_for_new_tasks": true
      },
      {
        "package_id": "driver.process_session",
        "default_for_new_tasks": false
      },
      {
        "package_id": "driver.git_worktree",
        "default_for_new_tasks": false
      }
    ],
    "triggers": [
      {
        "package_id": "world_system_review",
        "template_interface_id": "world_system_review",
        "interface_id": "world_self_improvement",
        "quiet_period_seconds": 3600,
        "task": {
          "worker_interface_id": "system_worker_system_review",
          "context_artifact_bindings": [
            {
              "id": "artifact-system-review-role"
            },
            {
              "id": "artifact-system-library"
            }
          ],
          "selected_worker_environment_kinds": [
            "browser_session",
            "code_mode",
            "desktop_session",
            "filesystem_workspace",
            "system_room"
          ],
          "door_host_slots": {
            "system_workspace_env": {
              "workspace_root": "/",
              "host_filesystem_root": "/"
            }
          }
        }
      },
      {
        "package_id": "world_memory_cron",
        "template_interface_id": "world_memory_cron",
        "interface_id": "world_memory_consolidation",
        "quiet_period_seconds": 10800,
        "task": {
          "worker_interface_id": "system_worker_memory_consolidation",
          "context_artifact_bindings": [
            {
              "id": "artifact-role-memory-consolidation"
            }
          ],
          "selected_worker_environment_kinds": [
            "system_room"
          ]
        }
      }
    ],
    "agent_presets": [
      {
        "id": "computer-use",
        "component_package_id": "driver.desktop_session",
        "name": "Computer Use",
        "icon": "goggles",
        "worker_interface_id": "system_worker_computer_use",
        "provider_interface_id": "world_provider_codex",
        "context_artifact_bindings": [
          {
            "id": "artifact-worker-role-template"
          },
          {
            "id": "artifact-worker-role-computer-use"
          },
          {
            "id": "artifact-grounding-system-architecture"
          },
          {
            "id": "artifact-secret-handle-flow"
          },
          {
            "id": "artifact-code-mode-cua-prelude"
          },
          {
            "id": "artifact-code-mode-browser-prelude"
          }
        ],
        "selected_worker_environment_kinds": [
          "desktop_session",
          "code_mode",
          "browser_session"
        ],
        "selected_application_ids": []
      }
    ]
  }
}
