{
  "name": "octopus-desktop-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/rebuild-native.cjs",
    "rebuild:native": "node scripts/rebuild-native.cjs",
    "sync:gesture-assets": "node scripts/sync-gesture-assets.cjs",
    "dev": "npm run sync:gesture-assets && npm run gen:licenses && vite --host 127.0.0.1",
    "dev:electron": "node scripts/dev-desktop.cjs",
    "dev:onboarding": "node scripts/dev-onboarding.cjs",
    "check:design-system": "node scripts/check-design-system.cjs",
    "test:chat-composer-contracts": "node scripts/test-chat-composer-contracts.cjs",
    "test:agent-templates": "node scripts/test-agent-templates.cjs",
    "test:chat-trace-contracts": "node scripts/test-chat-trace-contracts.cjs",
    "test:client-navigation": "node scripts/test-client-navigation.cjs",
    "test:client-interface-contracts": "node scripts/test-client-interface-contracts.cjs",
    "test:client-context-menu": "node scripts/test-client-context-menu.cjs",
    "test:task-archive": "node scripts/test-workspace-setup.cjs task-archive",
    "test:client-extensions": "node scripts/test-client-extensions.cjs",
    "test:client-setup": "node scripts/test-client-setup.cjs",
    "test:client-provider-metadata": "node --test scripts/test-client-provider-metadata.cjs",
    "test:files-contracts": "node scripts/test-files-contracts.cjs",
    "test:local-package-closure": "node scripts/test-local-package-closure.cjs",
    "test:local-packages": "node scripts/test-local-packages.cjs",
    "test:workspace-setup": "node scripts/test-workspace-setup.cjs",
    "test:hosts": "electron scripts/test-electron-hosts.cjs",
    "check:public-source": "node scripts/check-public-source.cjs",
    "export:package": "node scripts/export-public-package.cjs",
    "export:client-extension": "node scripts/export-public-client-extension.cjs",
    "verify:publication": "node scripts/verify-publication.cjs",
    "build": "npm run sync:gesture-assets && npm run gen:licenses && npm run check:design-system && tsc --noEmit && vite build",
    "build:cli": "node scripts/build-cli.cjs --runtime",
    "build:cli-client": "node scripts/build-cli.cjs",
    "test:cli": "node scripts/build-cli.cjs && node --test scripts/test-cli-client.cjs scripts/test-cli-transcript.cjs scripts/test-cli-terminal.cjs scripts/test-cli-package.cjs scripts/test-cli-inspection.cjs && node scripts/test-cli-setup.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "package:mac": "node scripts/package-macos.cjs",
    "desktop": "npm run package:mac && open -n ./build/Octopus.app",
    "gen:types": "node scripts/generate-schema-types.mjs",
    "gen:licenses": "node scripts/generate-client-licenses.mjs",
    "gen:code-theme-seeds": "node scripts/generate-code-theme-seeds.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@noble/hashes": "1.8.0",
    "@octopus/files-diffs": "npm:@pierre/diffs@1.5.2",
    "@pierre/diffs": "1.2.12",
    "@pierre/trees": "^1.0.0-beta.5",
    "@shikijs/themes": "4.3.1",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.17.1",
    "highlight.js": "^11.11.1",
    "katex": "0.18.0",
    "mermaid": "11.16.0",
    "motion": "^12.42.2",
    "node-pty": "^1.0.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "react": "^19.0.0",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.1",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@pierre/diffs@1.2.12": {
      "shiki": "4.3.1"
    },
    "@octopus/files-diffs": {
      "shiki": "3.20.0",
      "@shikijs/themes": "4.3.1"
    }
  }
}
